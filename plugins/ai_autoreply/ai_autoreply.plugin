__id__ = "ai_autoreply"
__name__ = "AI auto-reply"
__description__ = "Answers incoming messages with the app's AI in chats you explicitly add, in your own writing style (learns from your sent messages, splits and delays replies). Auto, draft or .ai command mode, with cooldown, daily and hourly caps and loop protection."
__author__ = "ZephyrGram"
__version__ = "0.3.0"
__version_code__ = 3
__api_version__ = 1
__min_app_version__ = "0.1.0"
__permissions__ = ["ai.complete", "chat.read", "messages.send", "ui.menu", "updates.read"]

import difflib
import json
import random
import re
import threading
import time
from collections import deque

from zephyr import BasePlugin, MenuItem, MenuType
from zephyr import client
from zephyr.ui import Header, Switch, Input, Selector, Text, Divider
try:
    from zephyr.ui import DialogPicker, UsernameInput
except ImportError:                      # older app: only the chat header menu can add chats
    DialogPicker = UsernameInput = None

MODE_AUTO = 0
MODE_DRAFT = 1
MODE_COMMAND = 2
MODE_NAMES = ["Auto (answer right away)", "Draft (put reply into the input field)",
              "Friend mode (the other person triggers with .ai)"]
MODES_HELP = (
    "Auto: the AI answers every message from the other person.\n"
    "Draft: the AI writes the reply into your input field; you send it.\n"
    "Friend mode: you stay silent. The OTHER person can ask the AI by starting a message "
    "with the trigger (default \".ai \"), e.g. \".ai tell me a joke\", and the AI answers "
    "in the chat. Messages without the trigger and your own messages are ignored.")

MAX_AGE_SEC = 180            # ignore messages older than this (offline catch-up)
MAX_FAILURES = 5             # consecutive AI/send failures before a chat is disabled
MAX_REPLY_CHARS = 1500
LOOP_SAME_TEXT = 3           # same sender, same text N times in a row -> loop
LOOP_BURST_COUNT = 4         # our replies within LOOP_BURST_SEC -> ping-pong, pause
LOOP_BURST_SEC = 120
ROBOT = "\U0001F916"
AUTO_MARKERS = (ROBOT, "auto-reply", "autoreply", "auto reply", "[auto]",
                "автовідповідь",
                "автоответ")
DEFAULT_PROMPT = (
    "You are replying on behalf of the owner of this Telegram account. Answer briefly and "
    "naturally, in the same language as the other person, in plain text without markdown. "
    "Never reveal secrets or personal data and do not make promises or payments on the "
    "owner's behalf. If asked directly, say you are an automatic AI assistant."
)



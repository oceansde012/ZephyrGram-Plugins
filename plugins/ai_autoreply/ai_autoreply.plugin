    "context_n": ("Context size (messages)", "Розмір контексту (повідомлень)", "Размер контекста (сообщений)"),
    "model": ("Model (empty = app default)", "Модель (порожньо = типова в застосунку)", "Модель (пусто = по умолчанию в приложении)"),
    "disclosure": ("Disclose AI in first reply", "Позначати ШІ в першій відповіді", "Помечать ИИ в первом ответе"),
    "disclosure_text": ("Disclosure prefix", "Префікс-позначка", "Префикс-пометка"),
    "trigger": ("Command trigger (Friend mode)", "Тригер команди (режим друга)", "Триггер команды (режим друга)"),
    "h_limits": ("Limits", "Ліміти", "Лимиты"),
    "debounce": ("Wait after last message (s)", "Очікування після останнього повідомлення (с)", "Ожидание после последнего сообщения (с)"),
    "debounce_s": ("Empty = preset (Balanced 4-6 s). Several messages in a row get one answer.",
                   "Порожньо = пресет (збалансований 4-6 с). Кілька повідомлень поспіль отримують одну відповідь.",
                   "Пусто = пресет (сбалансированный 4-6 с). Несколько сообщений подряд получают один ответ."),
    "cooldown": ("Min seconds between replies in a chat", "Мін. секунд між відповідями в чаті", "Мин. секунд между ответами в чате"),
    "cooldown_s": ("Empty = preset (Balanced 20).", "Порожньо = пресет (збалансований 20).", "Пусто = пресет (сбалансированный 20)."),
    "chat_hourly": ("Max replies per hour per chat", "Макс. відповідей на годину в чаті", "Макс. ответов в час в чате"),
    "chat_hourly_s": ("Empty = preset (Balanced 20). At the limit one polite line is sent, then silence.",
                      "Порожньо = пресет (збалансований 20). На ліміті надсилається один ввічливий рядок, далі тиша.",
                      "Пусто = пресет (сбалансированный 20). На лимите отправляется одна вежливая строка, дальше тишина."),
    "polite_stop": ("Polite stop at the hourly limit", "Ввічливо зупинитись на годинному ліміті", "Вежливо остановиться на часовом лимите"),
    "owner_active": ("Silent after you wrote in the chat (s)", "Мовчати після того, як ви писали в чаті (с)", "Молчать после того, как вы писали в чате (с)"),
    "owner_active_s": ("Empty = preset (Balanced 45). 0 = off. A message that arrives meanwhile is answered after this silence.",
                     "Порожньо = пресет (збалансований 45). 0 = вимк. Повідомлення, що прийшло за цей час, отримає відповідь після тиші.",
                     "Пусто = пресет (сбалансированный 45). 0 = выкл. Сообщение, пришедшее за это время, получит ответ после тишины."),
    "quiet": ("Quiet hours (HH:MM-HH:MM)", "Тихі години (ГГ:ХХ-ГГ:ХХ)", "Тихие часы (ЧЧ:ММ-ЧЧ:ММ)"),
    "quiet_s": ("Example 23:00-08:00. Empty = always allowed.", "Приклад 23:00-08:00. Порожньо = завжди дозволено.", "Пример 23:00-08:00. Пусто = всегда разрешено."),
    "skip_ack": ("Ignore plain 'ok / thanks / lol'", "Ігнорувати прості «ок / дякую / лол»", "Игнорировать простые «ок / спасибо / лол»"),
    "until_touch": ("Until you touch it the preset decides.", "Поки ви не змінили, вирішує пресет.", "Пока вы не изменили, решает пресет."),
    "group_q": ("Groups: only questions and requests", "Групи: лише питання й прохання", "Группы: только вопросы и просьбы"),
    "daily_cap": ("Daily cap per chat", "Денний ліміт на чат", "Дневной лимит на чат"),
    "hourly_cap": ("Hourly cap (all chats)", "Годинний ліміт (усі чати)", "Часовой лимит (все чаты)"),
    "h_chats": ("Chats", "Чати", "Чаты"),
    "paused": ("paused", "пауза", "пауза"),
    "chat_mode": ("Mode", "Режим", "Режим"),
    "chat_prompt": ("System prompt for this chat", "Системний промпт для цього чату", "Системный промпт для этого чата"),
    "chat_prompt_s": ("Empty = default prompt", "Порожньо = промпт за замовчуванням", "Пусто = промпт по умолчанию"),
    "chat_enabled": ("Enabled", "Увімкнено", "Включено"),
    "chat_test": ("Test style in this chat (nothing is sent)", "Тест стилю в цьому чаті (нічого не надсилається)", "Тест стиля в этом чате (ничего не отправляется)"),
    "chat_remove": ("Remove chat", "Видалити чат", "Удалить чат"),
    "no_chats": ("No chats yet. Type .ai on in a private chat, or add one below.",

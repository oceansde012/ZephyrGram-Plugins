# reason code (as stored in the decision log) -> (English, Ukrainian, Russian) plain-language explanation
R = {
    "memory_unavailable": ("Compact chat memory is unavailable; replying without updating it", "Стисла пам’ять чату недоступна; відповідь без її оновлення", "Краткая память чата недоступна; ответ без её обновления"),

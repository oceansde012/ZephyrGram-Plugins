def note(text):
    """Non-interactive multi-line explanation row. zephyr.ui.Divider renders its text as a plain grey
    block (UItem.asShadow): not clickable, wraps to the full text, unlike Text which is a one-line button."""
    d = Divider()
    d.text = str(text)
    return d


def tr(lang, key):
    row = S.get(key)
    if row is None:
        return key
    i = LANGS.index(lang) if lang in LANGS else 0
    return row[i] or row[0]


def reason_text(lang, code):
    """Plain-language explanation of a stored reason code (unknown codes are shown as they are)."""
    code = str(code or "")
    row = R.get(code)
    ms = re.match(r"^sticker_skipped_(\w+)$", code)
    if row is None and ms:
        base = R["sticker_skipped"]
        why = reason_text(lang, "sticker_why_" + ms.group(1))
        return (base[LANGS.index(lang) if lang in LANGS else 0] or base[0]) % why
    mw = re.match(r"^latency_wait_(\d+)$", code)
    if row is None and mw:
        base = R["latency_wait"]
        return (base[LANGS.index(lang) if lang in LANGS else 0] or base[0]) % mw.group(1)
    if row is None:
        for prefix in ("ok_fallback", "process_exception"):
            if code.startswith(prefix):
                row = R[prefix]
                break
    if row is None:
        return code.replace("_", " ")
    return row[LANGS.index(lang) if lang in LANGS else 0] or row[0]


# ---------------------------------------------------------------------- "bot writes first" command
FOLD_MAP = {ord(a): b for a, b in zip(u"аіїоеср", u"aiioecp")}


def fold_cmd(text):
    """Lower case + Cyrillic look-alikes folded to Latin, so '.аі' == '.ai'."""
    return str(text or "").lower().translate(FOLD_MAP)


DEFAULT_TRIGGERS = u".ai, .аі"
DEFAULT_OPENERS = [u"ну що там", u"як ти", u"чим займаєшся", u"ти як взагалі", u"що нового", u"є хвилинка?"]
DEFAULT_OPENERS_RU = [u"ну что там", u"как ты", u"чем занимаешься", u"ты как вообще", u"что нового", u"есть минутка?"]
DRAFT_WORDS = ("?", "draft", u"чернетка", u"черновик")
CMD_RULES = (
    "The owner typed a command: YOU write the next message in this chat on their behalf, in their own voice. "
    "Output only the text of that one message, nothing else. Never invent facts, plans, names or events that "
    "are not in the conversation or in the owner's instruction. Do not mention the instruction, do not say you "
    "are an AI. A line in square brackets at the end is the owner's private instruction to you, not something "
    "the other person said; never quote it.")

ADMIN_VERBS = {fold_cmd(k): v for k, v in {
    "on": "on", u"увімк": "on", u"увімкнути": "on", u"вкл": "on", u"включить": "on",
    "off": "off", u"вимк": "off", u"вимкнути": "off", u"викл": "off", u"выкл": "off", u"выключить": "off",
    "status": "status", u"статус": "status", u"стан": "status",
    "list": "list", u"список": "list",
    "mode": "mode", u"режим": "mode",
}.items()}
ADMIN_MODES = {fold_cmd(k): v for k, v in {
    "auto": MODE_AUTO, u"авто": MODE_AUTO, "draft": MODE_DRAFT, u"чернетка": MODE_DRAFT, u"черновик": MODE_DRAFT,
    "friend": MODE_COMMAND, u"друг": MODE_COMMAND, "command": MODE_COMMAND,
}.items()}


class ChatState(object):
    """In-memory runtime state of one allowlisted chat."""

    def __init__(self):
        self.pending = []                  # [(msg_id, from_id, text)]
        self.last_ts = 0.0                 # time of the last accepted incoming message
        self.timer = False                 # a debounce timer is scheduled
        self.inflight = False              # one in-flight request per chat
        self.cooldown_until = 0.0
        self.incoming = deque(maxlen=8)    # (from_id, normalized text)
        self.replies = deque(maxlen=16)    # timestamps of our replies
        self.seen = deque(maxlen=300)
        self.seen_set = set()
        self.info = None
        self.info_ts = 0.0
        self.recent = deque(maxlen=5)      # normalized texts of our last replies (de-duplication)
        self.first_ts = 0.0                # time of the first message of the pending batch
        self.owner_ts = 0.0                # last time the owner wrote in this chat
        self.answered = deque(maxlen=60)   # message ids we already replied to
        self.sent_h = deque(maxlen=200)    # timestamps of our sent replies (per-chat hourly cap)
        self.sending = False
        self.polite_ts = 0.0
        self.defers = 0                    # times the pending batch was held back by the owner-active rule
        self.last_in_ts = 0.0              # arrival of the latest incoming message
        self.last_act_ts = 0.0             # latest message of anybody (incoming, our reply, owner)
        self.last_reply_ts = 0.0           # latest reply of ours or of the owner
        self.last_send_ts = 0.0            # latest send by the plugin (stickers have no text to recognize)
        self.arr_ts = 0.0                  # arrival of the first message of the pending batch
        self.b_prev = (0.0, 0.0, 0.0)      # (last_in, last_act, last_reply) just before the pending batch
        self.cur = None                    # (arrival, prev_in, prev_act, prev_reply) of the batch being processed
        self.read_upto = 0                 # highest message id already marked as read
        self.ghost_note_ts = 0.0
        self.abort = ""                    # reason when a delivery was stopped while waiting
        self.last_sticker = (0, "")        # (id, set title) of the last sticker sent in this chat


class Plugin(BasePlugin):
    # ------------------------------------------------------------------ lifecycle
    def on_plugin_load(self):
        self._lock = threading.RLock()
        self._states = {}
        self._config_epoch = 0
        self._work_context = threading.local()
        self._media_pending = {}
        self._hourly = deque()             # timestamps of AI calls (global)
        self._profiles = {}                # chat key -> (ts, n, {"examples": [...], "style": {...}})
        self._rng = random.Random()
        self._testing = False
        self._testing_ts = 0.0
        self._scan_armed = False
        self._scan_stop = False
        self._scan_lock = threading.Lock()
        self._sticker_hist = deque(maxlen=6)
        self._tl_warned = set()
        self._marks = {}
        self._load_marks()
        self._load_decisions()
        self._load_bot_texts()
        self._load_chats()
        self.add_on_new_message_hook(priority=0)
        self.add_on_send_message_hook(priority=10)
        self._recent_ids = deque(maxlen=600)   # (chat key, message id) seen by either incoming path
        for hook_name in ("TL_updateShortMessage", "TL_updateShortChatMessage"):
            try:                               # private chats arrive as short updates, not updateNewMessage
                self.add_updates_hook(hook_name)
            except Exception as e:
                self.log("updates hook %s unavailable: %s" % (hook_name, e))
        self._lang_cache = {}              # chat key -> (ts, 'Ukrainian' | 'Russian' | None)
        self._open_key = None              # chat whose options are expanded in the settings screen
        self._cmd_busy = set()
        self._cmd_seen = {}                # chat key -> ts of the last command attempt seen by the send hook
        self._cmd_fallback = {}
        self._titles = {}
        self.add_menu_item(MenuItem(
            menu_type=MenuType.CHAT_ACTION, text=self.t("menu_off"),
            on_click=self.on_enable_click, priority=0,
            condition=self.cond_show_off, key="ai_autoreply_off"))
        self.add_menu_item(MenuItem(
            menu_type=MenuType.CHAT_ACTION, text=self.t("menu_on"),
            on_click=self.on_disable_click, priority=0,
            condition=self.cond_show_on, key="ai_autoreply_on"))
        self.add_menu_item(MenuItem(
            menu_type=MenuType.CHAT_ACTION, text=self.t("menu_cmd"),
            on_click=self.on_cmd_click, priority=0,
            condition=self.cond_show_cmd, key="ai_autoreply_cmd"))
        self.log("loaded %s v%s, %d chats, preset %s" % (self.name, self.version, len(self._chats),
                                                          PRESET_NAMES[self._preset_index()]))
        self._ensure_scan()

    def on_plugin_unload(self):
        self._scan_stop = True
        self._config_epoch += 1
        self._scan_armed = False
        self.log("unloaded")

    # ------------------------------------------------------------------ helpers
    def _now(self):
        return time.time()

    def _int(self, key, default, lo, hi):
        try:
            v = int(float(str(self.get_setting(key, default)).strip()))
        except (TypeError, ValueError):
            v = default
        return max(lo, min(hi, v))

    def _float(self, key, default, lo, hi):
        try:
            v = float(str(self.get_setting(key, default)).strip().replace(",", "."))
        except (TypeError, ValueError):
            v = default
        return max(lo, min(hi, v))

    def _humanize(self):
        return bool(self.get_setting("humanize", True))

    # ---- presets: an empty setting means "use the preset value"
    def _preset_index(self):
        try:
            i = int(self.get_setting("preset", LIVE_PRESET))
        except (TypeError, ValueError):
            i = LIVE_PRESET
        return i if 0 <= i < len(PRESETS) else LIVE_PRESET

    def _preset(self):
        d = dict(PRESET_BASE)
        d.update(PRESETS[self._preset_index()])
        return d

    def _live(self):
        """Human reply timing (Live preset, or switched on by hand)."""
        return self._pbool("human_timing")

    def _timing_params(self):
        keys = ("lat_warm_min", "lat_warm_max", "lat_cold_min", "lat_cold_max", "lat_long_pct", "lat_long_min",
                "lat_long_max", "warm_window", "cold_after", "type_ms", "warm_cap")
        return {k: self._pnum(k, 0, 100000) for k in keys}

    def _cooldown(self):
        base = self._pnum("cooldown", 0, 3600)
        jit = self._pnum("cooldown_jitter", 0, 3600)
        if self._explicit("cooldown") is None and jit > 0:
            base += self._rng.uniform(0, jit)
        return base

    def _max_age(self):
        """How old an incoming message may be and still be answered (seconds)."""
        if self._pbool("scan"):
            return self._pnum("catchup_min", 1, 1440) * 60.0
        return float(MAX_AGE_SEC)

    def _explicit(self, key):
        raw = self.get_setting(key, "")
        return None if raw is None or str(raw).strip() == "" else raw

    def _pnum(self, key, lo, hi):
        """Number from the setting, or from the preset when the setting is empty/invalid."""
        raw = self._explicit(key)
        if raw is not None:
            try:
                return max(lo, min(hi, float(str(raw).strip().replace(",", "."))))
            except (TypeError, ValueError):
                pass
        return max(lo, min(hi, float(self._preset()[key])))

    def _pbool(self, key):
        raw = self.get_setting(key, None)
        return bool(self._preset()[key]) if raw is None or raw == "" else bool(raw)

    def _debounce(self, jitter=False):
        base = self._pnum("debounce", 0, 60)
        if jitter and self._explicit("debounce") is None:
            base += self._rng.uniform(0, float(self._preset().get("debounce_jitter", 0)))
        return base

    # ---- decision log (no message text: only outcome, reason, chat id, time)
    def _load_decisions(self):
        try:
            data = json.loads(self.get_setting("decisions", "[]") or "[]")
        except (ValueError, TypeError):
            data = []
        self._decisions = deque((d for d in data if isinstance(d, dict)), maxlen=60)

    def _decide(self, key, outcome, reason, ring=True, x=None):
        """Record why a message was answered or skipped. Never raises. x = short extra text (for example an emoji)."""
        try:
            reason = re.sub(r"\W+", "_", str(reason).lower()).strip("_") or "unknown"
            self.log("decision %s %s %s" % (outcome, key, reason))
            if ring:
                with self._lock:
                    if (outcome == "seen" and self._decisions and self._decisions[-1].get("o") == "seen"
                            and self._decisions[-1].get("chat") == key):
                        self._decisions.pop()          # a run of received messages is one entry (newest time)
                    rec = {"t": int(self._now()), "chat": key, "o": outcome, "r": reason}
                    if x:
                        rec["x"] = str(x)[:12]
                    self._decisions.append(rec)
                    self.set_setting("decisions", json.dumps(list(self._decisions)))
        except Exception:
            pass
        return reason

    def decisions_text(self):
        rows = list(getattr(self, "_decisions", []))[-40:]
        if not rows:
            return "No decisions yet."
        out = []
        for r in reversed(rows):
            try:
                ts = time.strftime("%d.%m %H:%M:%S", time.localtime(float(r.get("t", 0))))
            except Exception:
                ts = "?"
            out.append("%s  chat %s  %s: %s" % (ts, r.get("chat"), r.get("o"), r.get("r")))
        return "\n".join(out)

    def _is_bot_text(self, text):
        low = str(text or "").lower()
        if norm_text(text)[:160] in self._bot_texts:
            return True
        prefix = str(self.get_setting("disclosure_text", ROBOT + " ") or "").strip().lower()
        return any(mk in low for mk in AUTO_MARKERS) or bool(prefix and low.startswith(prefix))

    def _in_quiet_hours(self):
        q = parse_quiet_hours(self.get_setting("quiet_hours", ""))
        if not q:
            return False
        lt = time.localtime(self._now())
        cur = lt.tm_hour * 60 + lt.tm_min
        a, b = q
        return (a <= cur < b) if a < b else (cur >= a or cur < b)

    def _banned_extra(self):
        raw = str(self.get_setting("banned_words", "") or "")
        return [w.strip().lower() for w in re.split(r"[,\n;]", raw) if w.strip()]

    def _load_bot_texts(self):
        try:
            data = json.loads(self.get_setting("bot_texts", "[]") or "[]")
        except (ValueError, TypeError):
            data = []
        self._bot_texts = deque((str(x) for x in data if x), maxlen=200)

    def _remember_bot_text(self, text):
        """Remember what the plugin itself sent, so it is never learned as the owner's style."""
        with self._lock:
            self._bot_texts.append(norm_text(text)[:160])
            self.set_setting("bot_texts", json.dumps(list(self._bot_texts), ensure_ascii=False))

    def _load_marks(self):
        try:
            data = json.loads(self.get_setting("scan_marks", "{}") or "{}")
        except (ValueError, TypeError):
            data = {}
        self._marks = {str(k): int(v) for k, v in (data.items() if isinstance(data, dict) else [])
                       if isinstance(v, int)}

    def _bump_mark(self, key, mid):
        """Remember the highest message id of a chat that went through the pipeline (survives restarts)."""
        if not isinstance(mid, int) or mid <= self._marks.get(key, 0):
            return
        with self._lock:
            self._marks[key] = mid
            if len(self._marks) > 200:
                for k in list(self._marks)[:50]:
                    self._marks.pop(k, None)
            self.set_setting("scan_marks", json.dumps(self._marks))

    @staticmethod
    def chat_key(account, dialog_id):
        return "%d:%d" % (int(account or 0), int(dialog_id))

    @staticmethod
    def _sk(key):
        return key.replace(":", "_").replace("-", "n")

    def _read_chats(self):
        """The chats dict as currently stored (the core app screen may have edited it)."""
        try:
            data = json.loads(self.get_setting("chats", "{}") or "{}")
            return data if isinstance(data, dict) else {}
        except (ValueError, TypeError):
            return {}

    def _load_chats(self):
        with self._lock:
            self._chats = self._read_chats()

    def _commit(self, key, set=None, drop=(), remove=False, create=False):
        """Reload-merge-save: re-read the stored chats, apply ONLY this mutation to one chat, write back.
        A newer external change (core screen) to other chats or other fields is never overwritten, and an
        entry removed externally is not resurrected unless create=True. Returns the stored entry or None."""
        with self._lock:
            disk = self._read_chats()
            cur = disk.get(key)
            if remove:
                disk.pop(key, None)
                cur = None
            else:
                if not isinstance(cur, dict):
                    if not create:
                        self._chats = disk
                        return None
                    cur = disk[key] = {}
                cur.update(set or {})
                for d in drop:
                    cur.pop(d, None)
            self.set_setting("chats", json.dumps(disk, ensure_ascii=False))
            self._chats = disk
            return cur

    def on_app_event(self, event):
        """The core app screen edited our prefs (chats, mode_/keep_/rlang_<sk>, master): reload what we cache.
        Debounce/cooldown/in-flight state (self._states) is deliberately kept. The event arrives as the plain
        string 'settings_changed' (PluginRuntime.dispatchAppEventTo); an enum-like object is handled too."""
        name = getattr(event, "name", None) or getattr(event, "value", None) or event
        name = str(name).strip().lower()
        if name in ("start", "resume"):
            self._catch_up_async("app_" + name)
            return
        if name != "settings_changed":
            return
        try:
            with self._lock:
                self._config_epoch += 1
                self._load_chats()
                self._lang_cache.clear()           # rlang_<sk> may have changed
                if self._open_key not in self._chats:
                    self._open_key = None
                for key in list(self._profiles):
                    if key not in self._chats:
                        self._profiles.pop(key, None)
            self.log("settings_changed: reloaded %d chats" % len(self._chats))
            self._ensure_scan()
        except Exception as e:
            self.error(e)

    def is_enabled(self, key):
        c = self._chats.get(key)
        return bool(c and c.get("enabled"))

    def _state(self, key):
        with self._lock:
            st = self._states.get(key)
            if st is None:
                st = self._states[key] = ChatState()
            return st

    def _chat_mode(self, key):
        try:
            return int(self.get_setting("mode_" + self._sk(key), MODE_AUTO))
        except (TypeError, ValueError):
            return MODE_AUTO

    def _chat_prompt(self, key):
        p = str(self.get_setting("prompt_" + self._sk(key), "") or "").strip()
        if p:
            return p
        g = str(self.get_setting("default_prompt", "") or "").strip()
        return g or DEFAULT_PROMPT

    def _to_dict(self, mo):
        fn = getattr(client, "message_to_dict", None)
        if fn is None:
            try:
                import zephyr
                fn = getattr(zephyr, "message_to_dict", None)
            except ImportError:
                fn = None
        if fn is not None:
            try:
                return dict(fn(mo))
            except Exception as e:
                self.error(e)
        # minimal fallback straight from the Java object
        d = {}
        try:
            d["id"] = int(mo.getId())
            d["out"] = bool(mo.isOutOwner())
            d["date"] = int(mo.messageOwner.date)
            d["text"] = str(mo.messageText or "")
            d["from_id"] = int(mo.getFromChatId())
            d["is_bot"] = False
        except Exception as e:
            self.error(e)
        return d

    @staticmethod
    def _dialog_id_of(mo, m):
        if m.get("dialog_id"):
            return int(m["dialog_id"])
        try:
            return int(mo.getDialogId())
        except Exception:
            return 0

    # ------------------------------------------------------------------ menu
    def cond_show_off(self, ctx):
        try:
            did = ctx.get("dialog_id") or 0
            return bool(did) and not self.is_enabled(self.chat_key(ctx.get("account"), did))
        except Exception:
            return False

    def cond_show_on(self, ctx):
        try:
            did = ctx.get("dialog_id") or 0
            return bool(did) and self.is_enabled(self.chat_key(ctx.get("account"), did))
        except Exception:
            return False

    def on_enable_click(self, ctx):
        account, did = ctx.get("account") or 0, ctx.get("dialog_id") or 0
        if not did:
            return
        key = self.chat_key(account, did)

        def work():
            try:
                info = client.get_dialog_info(did)
                reason = self.check_info(info)
                if reason:
                    client.bulletin(self.t("bl_na", self.rt(reason)))
                    return
                c = self.chat_on(account, did, str(info.get("title") or did), info.get("type"))
                self._decide(key, "cmd", "menu_on")
                client.bulletin(self.t("bl_on", c["title"]))
            except Exception as e:
                self.error(e)
                client.bulletin(self.t("bl_cannot"))
        client.run_in_bg(work)

    def on_disable_click(self, ctx):
        key = self.chat_key(ctx.get("account"), ctx.get("dialog_id") or 0)
        self.chat_off(key, remove=False)
        self._decide(key, "cmd", "menu_off")
        client.bulletin(self.t("bl_off"))

    # ---- shared add / remove (menu, command, pickers)
    def chat_on(self, account, did, title, kind):
        """Add or re-enable a chat. A new chat starts in mode Auto. Stored format: see docs/API.md."""
        key = self.chat_key(account, did)
        sk = self._sk(key)
        with self._lock:
            new = key not in self._read_chats()
            c = self._commit(key, set={"enabled": True, "account": int(account), "dialog_id": int(did),
                                       "title": str(title or did),
                                       "type": kind or ("user" if int(did) > 0 else "group"),
                                       "fails": 0}, drop=("auto_off_ts",), create=True)
        if new or self.get_setting("mode_" + sk, None) is None:
            self.set_setting("mode_" + sk, MODE_AUTO)
        self.set_setting("keep_" + sk, True)
        st = self._states.get(key)
        if st is not None:
            st.defers = 0
        return c

    def chat_off(self, key, remove):
        """Turn a chat off (remove=False: stays in the list as paused) or drop it. Returns its title or None."""
        sk = self._sk(key)
        with self._lock:
            c = self._chats.get(key)
            if c is None:
                return None
            title = str(c.get("title") or key)
            if remove:
                self._commit(key, remove=True)
                self._states.pop(key, None)
                self._profiles.pop(key, None)
            else:
                self._commit(key, set={"enabled": False}, drop=("auto_off_ts",))
        if remove:
            self.set_setting("mode_" + sk, None)
            self.set_setting("prompt_" + sk, None)
            self.set_setting("keep_" + sk, None)
            self.set_setting("rlang_" + sk, None)
        else:
            self.set_setting("keep_" + sk, False)
        return title

    @staticmethod
    def check_info(info):
        """Returns a reason string if the chat must never be auto-replied, else None."""
        if not isinstance(info, dict):
            return "unknown chat"
        t = info.get("type")
        if t == "secret":
            return "secret chat"
        if t == "channel":
            return "channel"
        if info.get("is_bot"):
            return "bot"
        if t not in ("user", "group"):
            return "unsupported chat type"
        return None

    # ------------------------------------------------------------------ incoming
    def on_new_message(self, account, message_object):
        try:
            self.handle_incoming(account, message_object)
        except Exception as e:
            self.error(e)
            self._decide("?", "error", "handle_incoming_exception")

    def _maybe_resume(self, key):
        """A chat disabled by repeated errors comes back after AUTH_RESUME_SEC (never stay silent forever)."""
        c = self._chats.get(key)
        if c and not c.get("enabled") and c.get("auto_off_ts"):
            if self._now() - float(c.get("auto_off_ts") or 0) >= AUTH_RESUME_SEC:
                with self._lock:
                    self._commit(key, set={"enabled": True, "fails": 0}, drop=("auto_off_ts",))
                self._decide(key, "resume", "auto_resumed_after_errors")

    def _note_owner(self, key, m):
        """Our own outgoing message: remember that the owner is active (plugin's own texts excluded)."""
        st = self._state(key)
        text = str(m.get("text") or "")
        if st.sending or (text.strip() and self._is_bot_text(text)):
            return
        if not text.strip() and self._now() - st.last_send_ts < 10:
            return                               # most likely our own sticker coming back as an outgoing event
        st.owner_ts = self._now()
        st.last_act_ts = st.last_reply_ts = st.owner_ts

    def handle_incoming(self, account, mo):
        m = self._to_dict(mo)
        return self._handle_dict(account, self._dialog_id_of(mo, m), m)

    def _dup_event(self, key, mid):
        """True when this (chat, message id) already came through the other incoming path."""
        if mid is None:
            return False
        with self._lock:
            ident = (key, mid)
            if ident in self._recent_ids:
                return True
            self._recent_ids.append(ident)
        return False

    def _handle_dict(self, account, did, m, via_scan=False):
        if not did:
            return None
        key = self.chat_key(account, did)
        self._maybe_resume(key)
        if m.get("out") and not self.is_enabled(key):
            try:                                   # '.ai on' must work in a chat that is not listed yet
                self._outgoing_command_fallback(account, did, key, m, admin_only=True)
            except Exception as e:
                self.error(e)
            return None
        if not self.is_enabled(key):
            return None
        if m.get("out"):
            self._note_owner(key, m)
            try:
                self._outgoing_command_fallback(account, did, key, m)
            except Exception as e:
                self.error(e)
            self._decide(key, "skip", "outgoing", ring=False)
            return "outgoing"
        if self._dup_event(key, m.get("id")):
            self._decide(key, "skip", "duplicate", ring=False)
            return "duplicate"
        # the owner can see that the plugin got the message (and whether it came from the safety-net scan)
        self._decide(key, "info" if via_scan else "seen", "scan_found" if via_scan else "incoming_seen")
        if not self.get_setting("master", True):
            self._decide(key, "skip", "master_off")
            return None
        m = self._prepare_media_message(key, m)
        reason = self.accept_message(key, m, max_age=self._max_age())
        if reason:
            self._decide(key, "skip", reason, ring=reason not in ("duplicate", "sender is bot"))
            return reason
        st = self._state(key)
        with self._lock:
            now = self._now()
            if not st.pending:
                st.first_ts = now
                st.defers = 0
                st.arr_ts = now
                st.b_prev = (st.last_in_ts, st.last_act_ts, st.last_reply_ts)
            st.pending.append((m.get("id"), m.get("from_id"), self._strip_trigger(key, m["text"])))
            st.last_ts = now
            st.last_in_ts = st.last_act_ts = now
            need_timer = not st.timer
            if need_timer:
                st.timer = True
        if need_timer:
            self._schedule(key, self._debounce(jitter=True))
        if self._read_enabled() and self.get_setting("read_always", False) and self._chat_mode(key) != MODE_COMMAND:
            delay = self._rng.uniform(1.0, 6.0)
            mid = m.get("id")
            self._run_later(delay, lambda: self._mark_read(key, mid))
        return None

    # Private chats (and basic groups) deliver messages as TL_updateShortMessage / TL_updateShortChatMessage
    # containers that never become an updateNewMessage, so on_new_message may not fire for them.
    def on_updates_hook(self, name, account, updates):
        try:
            m = self._short_update_dict(str(name), updates)
            if m is not None:
                did = m.pop("dialog_id")
                try:
                    client.run_in_bg(lambda: self._safe_handle(int(account or 0), did, m))
                except Exception:
                    self._safe_handle(int(account or 0), did, m)
        except Exception as e:
            self.log("updates hook failed: %s" % e)      # never self.error here: it counts toward auto-disable
        return None

    def _safe_handle(self, account, did, m):
        try:
            self._handle_dict(account, did, m)
        except Exception as e:
            self.error(e)
            self._decide("?", "error", "handle_incoming_exception")

    @staticmethod
    def _short_update_dict(name, u):
        """TL_updateShortMessage / TL_updateShortChatMessage -> the dict shape of message_to_dict (+ dialog_id)."""
        def g(*names):
            for n in names:
                try:
                    v = getattr(u, n)
                except Exception:
                    continue
                if v is not None:
                    return v
            return None
        if name.endswith("ShortChatMessage"):
            cid = int(g("chat_id") or 0)
            did = -abs(cid)
            try:
                fid = int(g("from_id") or 0)
            except (TypeError, ValueError):
                fid = 0
        elif name.endswith("ShortMessage"):
            did = int(g("user_id") or 0)
            fid = did
        else:
            return None
        if not did:
            return None
        date = g("date")
        return {"id": g("id"), "dialog_id": did, "from_id": fid, "out": bool(g("out")),
                "date": int(date) if date is not None else None, "text": str(g("message") or ""),
                "is_bot": False, "reply_to": None}

    def _trigger(self):
        t = str(self.get_setting("trigger", ".ai ") or ".ai ")
        return t if t.strip() else ".ai "

    def _strip_trigger(self, key, text):
        if self._chat_mode(key) == MODE_COMMAND:
            t = self._trigger()
            if text.lower().startswith(t.lower()):
                return text[len(t):].strip()
        return text

    def accept_message(self, key, m, max_age=None):
        """Safety filters for one incoming message. Returns skip reason or None (accept)."""
        if max_age is None:
            max_age = MAX_AGE_SEC
        st = self._state(key)
        if m.get("out"):
            return "outgoing"
        if m.get("is_bot"):
            return "sender is bot"
        text = m.get("text")
        if not isinstance(text, str) or not text.strip():
            return "no text / service message"
        mid = m.get("id")
        with self._lock:
            if mid is not None:
                if mid in st.seen_set:
                    return "duplicate"
                if len(st.seen) == st.seen.maxlen:
                    st.seen_set.discard(st.seen[0])
                st.seen.append(mid)
                st.seen_set.add(mid)
        self._bump_mark(key, mid)
        date = m.get("date")
        if date is not None:                # a missing/unparsable date is accepted, never a silent drop
            try:
                if self._now() - float(date) > max_age:
                    return "too old"
            except (TypeError, ValueError):
                pass
        low = text.lower()
        prefix = str(self.get_setting("disclosure_text", ROBOT + " ") or "").strip().lower()
        if any(mk in low for mk in AUTO_MARKERS) or (prefix and low.startswith(prefix)):
            return "looks like an auto-reply"
        with self._lock:
            st.incoming.append((m.get("from_id"), norm_text(text)))
            tail = list(st.incoming)[-LOOP_SAME_TEXT:]
            if len(tail) == LOOP_SAME_TEXT and len(set(tail)) == 1:
                return "repeated identical text"
            now = self._now()
            if len([t for t in st.replies if now - t < LOOP_BURST_SEC]) >= int(self._pnum("loop_burst", 1, 1000)):
                return "reply burst (possible loop)"
        if self._chat_mode(key) == MODE_COMMAND and not low.startswith(self._trigger().lower()):
            return "no command prefix"
        return None

    # ------------------------------------------------------------------ scheduling
    def _schedule(self, key, delay_s):
        try:
            client.run_on_ui(lambda: client.run_in_bg(lambda: self.tick(key)),
                             delay_ms=int(max(0.0, delay_s) * 1000))
        except Exception as e:                # never leave the timer flag stuck: fall back to a thread timer
            self.error(e)
            self._decide(key, "error", "schedule_failed_fallback_timer")
            t = threading.Timer(max(0.0, delay_s), lambda: self.tick(key))
            t.daemon = True
            t.start()

    def tick(self, key):
        """Debounce timer fired (runs in a background worker)."""
        st = self._state(key)
        try:
            now = self._now()
            deb = self._debounce()
            batch = None
            with self._lock:
                if not st.pending:
                    st.timer = False
                    return
                due = min(st.last_ts + deb, st.first_ts + MAX_DEBOUNCE_TOTAL)
                wait = max(due - now, st.cooldown_until - now)
                if wait > 0:
                    pass                    # timer stays set, re-armed below
                elif st.inflight:
                    st.timer = False        # the running request reschedules when done
                    return
                else:
                    st.timer = False
                    st.inflight = True
                    batch, st.pending = st.pending, []
                    st.cur = (st.arr_ts or now,) + tuple(st.b_prev)
            if batch is None:
                self._schedule(key, wait + 0.05)
                return
            try:
                self.process(key, batch)
            finally:
                with self._lock:
                    st.inflight = False
                    again = bool(st.pending) and not st.timer
                    if again:
                        st.timer = True
                        st.first_ts = self._now()
                if again:
                    self._schedule(key, self._debounce(jitter=True))
        except Exception as e:
            self.error(e)
            self._decide(key, "error", "tick_exception")
            with self._lock:
                st.timer = False

    # ------------------------------------------------------------------ safety-net scan
    def _run_later(self, delay_s, fn):
        """fn in a background worker after delay_s seconds; never blocks the caller."""
        try:
            client.run_on_ui(lambda: client.run_in_bg(fn), delay_ms=int(max(0.0, delay_s) * 1000))
        except Exception as e:
            self.log("run_later fallback: %s" % e)
            t = threading.Timer(max(0.0, delay_s), fn)
            t.daemon = True
            t.start()

    def _scan_enabled(self):
        return bool(self._pbool("scan"))

    def _scan_idle(self):
        return (not self.get_setting("master", True)) or not any(
            c.get("enabled") for c in self._chats.values())

    def _ensure_scan(self):
        """Start the periodic chain once (only while the scan is on in the current preset/settings)."""
        try:
            if self._scan_stop or not self._scan_enabled():
                return
            with self._lock:
                if self._scan_armed:
                    return
                self._scan_armed = True
            self._run_later(5.0, self._scan_tick)
        except Exception as e:
            self._scan_armed = False
            self.log("scan not started: %s" % e)

    def _scan_tick(self):
        delay = 60.0
        try:
            if self._scan_stop or not self._scan_enabled():
                self._scan_armed = False
                return
            if not self._scan_idle():
                self._scan_all("periodic")
                delay = self._pnum("scan_interval", 10, 600) * self._rng.uniform(0.85, 1.15)
        except Exception as e:
            self.log("scan failed: %s" % e)
        finally:
            if self._scan_armed and not self._scan_stop:
                self._run_later(delay, self._scan_tick)

    def _catch_up_async(self, why):
        """App start/resume: look for missed messages soon (and make sure the periodic scan runs)."""
        try:
            if not self._scan_enabled():
                return
            self._ensure_scan()
            self._run_later(1.5, lambda: self._scan_all(why))
        except Exception as e:
            self.log("catch-up not started: %s" % e)

    def _scan_all(self, why="periodic"):
        """One pass over the enabled chats; returns the number of messages fed into the pipeline."""
        if not self._scan_lock.acquire(False):
            return 0
        found = 0
        try:
            if not self.get_setting("master", True):
                return 0
            for key, c in sorted(self._chats.items()):
                if self._scan_stop:
                    break
                if not c.get("enabled"):
                    continue
                try:
                    found += self._scan_chat(key, c)
                except Exception as e:
                    self.log("scan of %s failed: %s" % (key, e))
        finally:
            self._scan_lock.release()
        return found

    def _scan_chat(self, key, c):
        """Incoming messages after the last outgoing one that no event delivered yet."""
        did, account = int(c["dialog_id"]), int(c.get("account", 0))
        window = self._max_age()
        hist = client.get_recent_messages(did, limit=self._int("scan_limit", 8, 3, 30), account=account) or []
        rows = sorted((h for h in hist if isinstance(h, dict)), key=lambda h: (h.get("date") or 0, h.get("id") or 0))
        tail = []
        for h in reversed(rows):                       # incoming run after the newest outgoing message
            if h.get("out"):
                break
            tail.insert(0, h)
        st = self._state(key)
        now = self._now()
        mark = self._marks.get(key, 0)
        cand = []
        for h in tail:
            mid = h.get("id")
            if h.get("is_service") or (not str(h.get("text") or "").strip() and not h.get("has_media")):
                continue
            try:
                age = now - float(h.get("date") or 0)
            except (TypeError, ValueError):
                continue
            if age > window or age < SCAN_GRACE_SEC:
                continue
            if isinstance(mid, int) and (mid <= mark or mid in st.seen_set or mid in st.answered):
                continue
            if (key, mid) in self._recent_ids:
                continue
            cand.append(h)
        n = 0
        for h in cand[-SCAN_MAX_FOUND:]:
            m = dict(h)
            m["out"] = False
            m.setdefault("dialog_id", did)
            if self._handle_dict(account, did, m, via_scan=True) is None:
                n += 1
        return n

    # ------------------------------------------------------------------ caps
    def _day(self):
        return time.strftime("%Y-%m-%d", time.localtime(self._now()))

    def _usage(self):
        try:
            u = json.loads(self.get_setting("usage", "{}") or "{}")
        except (ValueError, TypeError):
            u = {}
        if not isinstance(u, dict) or u.get("day") != self._day() or not isinstance(u.get("n"), dict):
            u = {"day": self._day(), "n": {}}
        return u

    def caps_ok(self, key):
        """Returns a skip reason or None; does not count."""
        now = self._now()
        with self._lock:
            while self._hourly and now - self._hourly[0] > 3600:
                self._hourly.popleft()
            cap = int(self._pnum("hourly_cap", 0, 100000))
            if cap and len(self._hourly) >= cap:                  # 0 = no global hourly cap (Live)
                return "hourly cap reached"
            if self._usage()["n"].get(key, 0) >= int(self._pnum("daily_cap", 1, 100000)):
                return "daily cap reached"
        return None

    def chat_hourly_ok(self, st):
        now = self._now()
        with self._lock:
            while st.sent_h and now - st.sent_h[0] > 3600:
                st.sent_h.popleft()
            return len(st.sent_h) < int(self._pnum("chat_hourly", 1, 1000))

    def count_use(self, key):
        with self._lock:
            self._hourly.append(self._now())
            u = self._usage()
            u["n"][key] = u["n"].get(key, 0) + 1
            self.set_setting("usage", json.dumps(u))

    def _fail(self, key, err):
        self.log("failure in %s: %s" % (key, err))
        with self._lock:
            c = self._chats.get(key)
            if not c:
                return
            fails = int(c.get("fails", 0)) + 1
            upd = {"fails": fails}
            if fails >= MAX_FAILURES:
                upd.update({"enabled": False, "auto_off_ts": self._now()})
                self.log("auto-disabled %s after %d failures" % (key, fails))
                self._decide(key, "disabled", "auto_disabled_after_errors")
                client.bulletin(self.t("bl_errors_off", c.get("title", key)))
            self._commit(key, set=upd)

    # ------------------------------------------------------------------ processing
    def _info(self, key, did):
        st = self._state(key)
        now = self._now()
        if st.info is None or now - st.info_ts > 600:
            st.info = client.get_dialog_info(did)
            st.info_ts = now
        return st.info

    def process(self, key, batch):
        """Never raises: every outcome is logged as a decision."""
        previous = getattr(self._work_context, "task", None)
        self._work_context.task = (key, self._config_epoch)
        self._work_context.images = []
        try:
            return self._process(key, batch)
        except Exception as e:
            self.error(e)
            self._decide(key, "error", "process_exception_%s" % type(e).__name__)
            try:
                self._fail(key, e)
            except Exception:
                pass
            return "error"
        finally:
            self._work_context.task = previous
            self._work_context.images = []

    def _skip(self, key, reason):
        self._decide(key, "skip", reason)
        return reason

    def _owner_active_in(self, hist, window):
        """Newest owner (non-plugin) message in the history younger than window seconds?"""
        now = self._now()
        for h in hist:
            if not h.get("out") or h.get("is_service"):
                continue
            t = str(h.get("text") or "")
            if t.strip() and self._is_bot_text(t):
                continue
            try:
                if now - float(h.get("date") or 0) < window:
                    return True
            except (TypeError, ValueError):
                pass
        return False

    def _defer_owner(self, key, st, batch, remaining):
        """The owner wrote here recently: log why, and (a limited number of times) answer after the silence
        window instead of dropping the message. A reply the owner already gave is detected later
        (the last message is no longer from them)."""
        live = self._live()
        limit = int(self._pnum("owner_defers", 0, 100)) if live else MAX_OWNER_DEFERS
        deferred = False
        with self._lock:
            if st.defers < limit:
                deferred = True
                st.defers += 1
                if live and st.cur:
                    if st.pending:
                        st.arr_ts = min(st.arr_ts or st.cur[0], st.cur[0])
                    else:
                        st.arr_ts, st.b_prev = st.cur[0], tuple(st.cur[1:])
                st.pending = list(batch) + st.pending
                st.cooldown_until = max(st.cooldown_until, self._now() + max(1.0, remaining) + 1.0)
        if live and deferred:
            self._decide(key, "defer", "deferred_owner_active")
        else:
            self._skip(key, "owner active")
        return "owner active"

    def _polite_stop(self, key, c, st, did, batch):
        """Hourly cap reached: one short polite line per hour, then silence."""
        if not self.get_setting("polite_stop", True) or self._now() - st.polite_ts < 3600:
            return False
        text = str(self.get_setting("polite_text", "") or "").strip() or POLITE_STOP_TEXT
        try:
            st.sending = True
            self.send(did, text, None)
            self._remember_bot_text(text)
        finally:
            st.sending = False
        st.polite_ts = self._now()
        self._decide(key, "sent", "polite_stop")
        return True

    def _process(self, key, batch):
        c = self._chats.get(key)
        if not c or not c.get("enabled") or not self.get_setting("master", True):
            return self._skip(key, "disabled")
        st = self._state(key)
        did, account = int(c["dialog_id"]), int(c.get("account", 0))
        mode = self._chat_mode(key)
        auto = mode == MODE_AUTO
        humanize = self._humanize()
        live = self._live()
        batch = [b for b in batch if b[0] is None or b[0] not in st.answered]
        if not batch:
            return self._skip(key, "already answered")
        if auto and self._in_quiet_hours():
            return self._skip(key, "quiet hours")
        if (humanize and self.get_setting("skip_emoji", True)
                and all(is_emoji_only(t) for _, _, t in batch)):
            return self._skip(key, "emoji only")
        ack_hint = False
        if auto and self._pbool("skip_ack") and all(is_ack(t) for _, _, t in batch):
            pct = self._pnum("ack_reply_pct", 0, 100)
            if pct and self._rng.random() * 100.0 < pct:
                ack_hint = True                      # a human answers 'ок' with 'ага' now and then
            else:
                return self._skip(key, "acknowledgement")
        if (auto and c.get("type") == "group" and self._pbool("group_need_question")
                and not any(has_request(t) for _, _, t in batch)):
            return self._skip(key, "group no question")
        if live and auto and st.cur and st.owner_ts > st.cur[0]:
            return self._skip(key, "owner replied")      # you answered this message yourself
        window = self._pnum("owner_active", 0, 3600)
        if auto and window and self._now() - st.owner_ts < window:
            return self._defer_owner(key, st, batch, window - (self._now() - st.owner_ts))
        reason = self.caps_ok(key)
        if reason:
            return self._skip(key, reason)
        if mode != MODE_DRAFT and not self.chat_hourly_ok(st):
            if auto:
                try:
                    self._polite_stop(key, c, st, did, batch)
                except Exception as e:
                    self.error(e)
            return self._skip(key, "chat hourly cap")
        try:
            reason = self.check_info(self._info(key, did))
        except Exception as e:
            self._fail(key, e)
            return self._skip(key, "info failed")
        if reason:
            return self._skip(key, reason)
        try:
            hist = self._load_history(key, account, did, self._int("context_n", 10, 1, 40))
            if auto and window and self._owner_active_in(hist, window):
                st.owner_ts = self._now()
                return self._defer_owner(key, st, batch, window)
            messages = self.build_messages(key, account, did, batch, hist)
        except Exception as e:
            self._fail(key, e)
            return self._skip(key, "context failed")
        messages, images = self._attach_current_media(key, account, did, messages, batch)
        self._work_context.images = images
        if not self._task_alive(key, account, did):
            return self._skip(key, "disabled meanwhile")
        if not messages:
            return self._skip(key, "empty context (last message is not from them)")
        max_id = max([b[0] for b in batch if isinstance(b[0], int)] or [0])
        kind, arrival = "warm", self._now()
        if live and mode != MODE_DRAFT:
            kind, arrival = self._conv_kind(st, hist, batch)
        read_id = max_id if (mode != MODE_DRAFT and max_id and self._read_enabled()) else 0
        cold_read = 0
        if read_id:
            if live and kind == "cold":
                cold_read = read_id                  # cold start: read right before the typing starts
            else:
                self._mark_read(key, read_id)
        self.count_use(key)
        extra = ""
        if ack_hint:
            extra = ("The other person only acknowledged something. Answer with one or two words at most "
                     "(like 'ага', 'ок', 'ну') in their language, nothing else.")
        try:
            parts, why = self.generate(key, account, did, messages, c, st,
                                       split=(mode != MODE_DRAFT), extra_system=extra)
        except Exception as e:
            self._fail(key, e)
            return self._skip(key, "ai failed")
        if not self._task_alive(key, account, did):
            return self._skip(key, "disabled meanwhile")
        if not parts:
            if why == "empty":
                self._fail(key, "empty AI reply")
                return self._skip(key, "empty reply")
            return self._skip(key, why or "no reply")
        # state may have changed during the (slow) AI call
        c = self._chats.get(key)
        if not self._task_alive(key, account, did):
            return self._skip(key, "disabled meanwhile")
        try:
            if mode == MODE_DRAFT:
                self._set_draft(did, "\n".join(parts), account)
                st.recent.append(norm_text(" ".join(parts)))
            else:
                if live:
                    parts = self._maybe_split2(parts)
                sticker = self._maybe_sticker(c, did, account, batch, parts, ack_hint, key=key, hist=hist)
                if sticker and sticker.get("instead"):
                    parts = []
                timing = self._make_timing(key, st, kind, arrival, batch, parts, cold_read) if live else None
                ok = self.deliver(key, c, st, did, parts, batch, humanize, timing=timing, sticker=sticker)
                if ok is False:
                    return self._skip(key, st.abort or "disabled meanwhile")
        except Exception as e:
            self._fail(key, e)
            return self._skip(key, "send failed")
        with self._lock:
            for b in batch:
                if b[0] is not None:
                    st.answered.append(b[0])
            st.cooldown_until = self._now() + self._cooldown()
            st.defers = 0
            upd = {"fails": 0}
            if c.get("disclosed"):
                upd["disclosed"] = True
            self._commit(key, set=upd)
        self._decide(key, "draft" if mode == MODE_DRAFT else "sent",
                     "ok_fallback_" + why if why else "ok")
        return "ok"

    # ---- human timing
    def _conv_kind(self, st, hist, batch):
        """('warm' | 'medium' | 'cold', arrival time of the batch) from our own memory and the history."""
        p = self._timing_params()
        cur = st.cur or (self._now(), 0.0, 0.0, 0.0)
        arr, p_in, p_act, p_rep = cur
        ids = set(b[0] for b in batch)
        for h in hist:
            if h.get("id") in ids:
                continue
            try:
                d = float(h.get("date") or 0)
            except (TypeError, ValueError):
                continue
            if d <= 0 or d > arr + 1:
                continue
            p_act = max(p_act, d)
            if h.get("out"):
                p_rep = max(p_rep, d)
            else:
                p_in = max(p_in, d)
        gap = lambda t: (arr - t) if t else None
        return conv_kind(gap(p_in), gap(p_act), gap(p_rep), p), arr

    def _make_timing(self, key, st, kind, arrival, batch, parts, read_id):
        """How long to wait (from now) before the first part, and how much of it to show 'typing'."""
        p = self._timing_params()
        in_len = sum(len(b[2] or "") for b in batch)
        reply_len = sum(len(x) for x in parts)
        total, type_s = latency_seconds(self._rng, kind, in_len, reply_len, p)
        wait = max(0.0, total - (self._now() - arrival))
        if wait >= 1.0:
            self._decide(key, "info", "latency_wait_%d" % int(round(wait)))
        return {"wait": wait, "type": min(wait, type_s), "arr": arrival, "read_id": read_id}

    def _maybe_split2(self, parts):
        if len(parts) != 1 or not self.get_setting("split_msgs", True):
            return parts
        if self._rng.random() * 100.0 >= self._pnum("split2_pct", 0, 100):
            return parts
        two = split_reply(parts[0], 2)
        return two if len(two) == 2 else parts

    def _alive(self, key, st, arrival):
        cur = self._chats.get(key)
        if not cur or not cur.get("enabled") or not self.get_setting("master", True):
            st.abort = "disabled meanwhile"
            return False
        if st.owner_ts > arrival:
            st.abort = "owner replied"
            return False
        return True

    def _live_wait(self, key, c, st, did, account, timing):
        """Sleep the human latency in short chunks; typing indicator during the last part. False = stop."""
        total, tsecs = float(timing["wait"]), float(timing["type"])
        quiet = max(0.0, total - tsecs)
        waited = 0.0
        while waited < quiet - 1e-9:
            ch = min(TYPING_REFRESH_SEC, quiet - waited)
            time.sleep(ch)
            waited += ch
            if not self._alive(key, st, timing["arr"]):
                return False
        if timing.get("read_id"):
            self._mark_read(key, timing["read_id"])
        shown = False
        show = bool(self.get_setting("show_typing", True))
        while waited < total - 1e-9:
            if show and self._send_typing(did, account):
                shown = True
            ch = min(TYPING_REFRESH_SEC, total - waited)
            time.sleep(ch)
            waited += ch
            if not self._alive(key, st, timing["arr"]):
                if shown:
                    self._send_typing(did, account, cancel=True)
                return False
        if shown:
            self._decide(key, "info", "typing_sent")
        return True

    # ---- reading and typing (TL through client.send_request; helpers of newer apps are preferred)
    def _read_enabled(self):
        return bool(self.get_setting("read_msgs", True))

    def _ghost_flags(self):
        """(no_read, no_typing) of the app's ghost mode, or (False, False) when it cannot be seen."""
        try:
            zc = _jclass("org.telegram.messenger.zephyr.ZephyrConfig")
            try:
                zc.load()
            except Exception:
                pass
            return bool(zc.ghostNoRead), bool(zc.ghostNoTyping)
        except Exception:
            return False, False

    def _tl_warn(self, what, e):
        if what not in self._tl_warned:
            self._tl_warned.add(what)
            self.log("%s unavailable: %s" % (what, e))

    def _mark_read(self, key, max_id):
        """messages.readHistory for a private chat (once per message id). Returns True if requested."""
        try:
            st = self._state(key)
            c = self._chats.get(key)
            if not c or not max_id or max_id <= st.read_upto or not self._read_enabled():
                return False
            did, account = int(c["dialog_id"]), int(c.get("account", 0))
            if did <= 0:
                return False                         # private chats only
            if self._ghost_flags()[0]:
                if self._now() - st.ghost_note_ts > 3600:
                    st.ghost_note_ts = self._now()
                    self._decide(key, "info", "read_blocked_by_ghost")
                return False
            done = False
            for name in ("mark_read", "read_history"):
                fn = getattr(client, name, None)
                if fn is not None:
                    fn(did, int(max_id), account=account)
                    done = True
                    break
            if not done:
                mc = _jclass("org.telegram.messenger.MessagesController").getInstance(account)
                req = _jclass("org.telegram.tgnet.TLRPC$TL_messages_readHistory")()
                req.peer = mc.getInputPeer(did)
                req.max_id = int(max_id)
                client.send_request(req, None, account)
            st.read_upto = int(max_id)
            self._decide(key, "info", "read_sent")
            return True
        except Exception as e:
            self._tl_warn("read", e)
            return False

    def _send_typing(self, did, account, cancel=False):
        """One 'typing…' action (or cancel). Never raises."""
        try:
            if self._ghost_flags()[1]:
                return False
            for name in ("set_typing", "send_typing"):
                fn = getattr(client, name, None)
                if fn is not None:
                    fn(did, account=account) if not cancel else fn(did, account=account, cancel=True)
                    return True
            mc = _jclass("org.telegram.messenger.MessagesController").getInstance(account)
            req = _jclass("org.telegram.tgnet.TLRPC$TL_messages_setTyping")()
            req.flags = 0
            req.peer = mc.getInputPeer(int(did))
            req.action = _jclass("org.telegram.tgnet.TLRPC$" + (
                "TL_sendMessageCancelAction" if cancel else "TL_sendMessageTypingAction"))()
            client.send_request(req, None, account)
            return True
        except Exception as e:
            self._tl_warn("typing", e)
            return False

    # ---- per-chat attachment consent and in-flight cancellation
    def _media_flag(self, key, name):
        c = self._chats.get(key)
        value = self.get_setting(name + "_" + self._sk(key), False)
        return bool(c and c.get("enabled") and (value is True or str(value).lower() == "true"))

    def _media_consent_changed(self, _value):
        with self._lock:
            self._config_epoch += 1

    def _task_alive(self, key, account, did):
        task = getattr(self._work_context, "task", None)
        c = self._chats.get(key)
        return bool(not self._scan_stop and c and c.get("enabled") and self.get_setting("master", True)
                    and self.chat_key(account, did) == key
                    and int(c.get("account", 0)) == int(account) and int(c.get("dialog_id", 0)) == int(did)
                    and (task is None or task == (key, self._config_epoch)))

    def _prepare_media_message(self, key, message):
        m = dict(message)
        if m.get("is_service") or m.get("is_secret") or not m.get("has_media"):
            return m
        account, did = (int(v) for v in key.split(":"))
        if int(m.get("dialog_id", did)) != did or int(m.get("account", account)) != account:
            return dict(m, text="", has_media=False)
        if not (self._media_flag(key, "see_media") or self._media_flag(key, "transcribe_voice")):
            return m
        mid = m.get("id")
        if isinstance(mid, int) and mid > 0:
            with self._lock:
                self._media_pending[(key, mid)] = {"text": str(m.get("text") or ""), "epoch": self._config_epoch}
                while len(self._media_pending) > 300:
                    self._media_pending.pop(next(iter(self._media_pending)))
            if not str(m.get("text") or "").strip():
                m["text"] = "[incoming attachment]"
        return m

    def _attach_current_media(self, key, account, did, messages, batch):
        """Only this batch's incoming IDs are eligible, never another chat or historical media."""
        notes, images = [], []
        readable = any(str(text).strip() and text != "[incoming attachment]" for _mid, _fid, text in batch)
        for mid, _fid, _text in batch[-4:]:
            pending = self._media_pending.get((key, mid))
            if not pending or pending["epoch"] != self._config_epoch or not self._task_alive(key, account, did):
                continue
            see = self._media_flag(key, "see_media")
            voice = self._media_flag(key, "transcribe_voice")
            if see and callable(getattr(client, "get_message_media", None)):
                try:
                    info = client.get_message_media(did, mid, account=account) or {}
                    if not self._task_alive(key, account, did) or not self._media_flag(key, "see_media"):
                        return [], []
                    if info.get("type", info.get("kind")) not in ("voice", "audio"):
                        desc = ", ".join(str(info.get(k))[:120] for k in ("type", "kind", "emoji", "set_title") if info.get(k))
                        image = info.get("image_b64")
                        if isinstance(image, str) and 0 < len(image) <= 550000 and len(images) < 2:
                            images.append(image)
                            desc += "; image/frame attached"
                        if desc:
                            notes.append("[Incoming attachment %s: %s. Do not invent details that are not visible.]" % (mid, desc))
                            readable = True
                except Exception:
                    self._decide(key, "info", "media_unavailable")
            if voice and callable(getattr(client, "get_voice", None)) and callable(getattr(client, "ai_transcribe", None)):
                try:
                    audio = client.get_voice(did, mid, account=account) or {}
                    if not self._task_alive(key, account, did) or not self._media_flag(key, "transcribe_voice"):
                        return [], []
                    if audio.get("audio_b64") and not audio.get("error"):
                        transcript = client.ai_transcribe(audio["audio_b64"], mime=audio.get("mime") or "audio/ogg")
                        if not self._task_alive(key, account, did) or not self._media_flag(key, "transcribe_voice"):
                            return [], []
                        transcript = str(transcript or "").strip()[:6000]
                        if transcript:
                            notes.append("[Voice message %s transcription (may contain errors): %s]" % (mid, transcript))
                            readable = True
                            self._decide(key, "info", "voice_transcribed")
                    elif audio.get("error") not in (None, "not_audio"):
                        self._decide(key, "info", "voice_unavailable")
                except Exception:
                    # 403/unsupported transcription is a feature failure, not a failed chat or an invented transcript.
                    self._decide(key, "info", "voice_transcription_unavailable")
        if not readable:
            return [], []
        result = [dict(m) for m in messages]
        for m in result:
            m["content"] = str(m.get("content") or "").replace("[incoming attachment]", "[attachment]")
        if notes and result:
            result[-1]["content"] += "\n" + "\n".join(notes)
        return result, images

    def _complete_for_chat(self, key, account, did, messages, **kwargs):
        task = getattr(self._work_context, "task", None)
        if task is not None and not self._task_alive(key, account, did):
            return ""
        images = getattr(self._work_context, "images", []) if task and task[0] == key else []
        if images:
            if not self._media_flag(key, "see_media"):
                return ""
            kwargs["images"] = list(images)
        return client.ai_complete(messages, **kwargs)

    def _set_draft(self, did, text, account):
        try:
            return client.set_draft(did, text, account=account)
        except TypeError:
            if int(client.current_account()) != int(account):
                raise RuntimeError("Explicit-account drafts are unavailable")
            return client.set_draft(did, text)

    # ---- stickers
    def _media_notes(self, did, account, hist):
        """Descriptions of the newest incoming media (stickers/photos/GIFs) via client.get_message_media, when
        the app has it and 'See media' is on. Never raises."""
        out = []
        try:
            fn = getattr(client, "get_message_media", None)
            key = self.chat_key(account, did)
            if fn is None or not self._media_flag(key, "see_media") or not self._task_alive(key, account, did):
                return out
            for h in [h for h in (hist or []) if not h.get("out") and h.get("has_media")
                      and not h.get("is_secret") and int(h.get("dialog_id", did)) == int(did)][-2:]:
                if not self._media_flag(key, "see_media") or not self._task_alive(key, account, did):
                    return []
                info = fn(did, h.get("id"), account=account)
                if isinstance(info, dict):
                    if not self._media_flag(key, "see_media") or not self._task_alive(key, account, did):
                        return []
                    bits = [str(info.get(k)) for k in ("type", "kind", "emoji", "set_title", "description") if info.get(k)]
                    if bits:
                        out.append(u"[media: %s]" % u", ".join(bits))
        except Exception as e:
            self._tl_warn("media", e)
        return out

    def _sticker_prompt(self, cands, texts, parts, hist, media):
        lines = []
        for h in list(hist or [])[-6:]:
            t = str(h.get("text") or "").strip()
            if t:
                lines.append(u"- %s: %s" % (u"me" if h.get("out") else u"them", t[:160]))
        body = u"Recent chat:\n%s\n" % (u"\n".join(lines) or u"- (none)")
        if media:
            body += u"Incoming media: %s\n" % u" ".join(media)
        body += u"Incoming now: %s\nMy text reply: %s\n\nSTICKER CANDIDATES:\n" % (
            u" / ".join(t[:200] for t in texts) or u"(no text)", u" / ".join(parts) or u"(none yet)")
        for num, s in cands:
            body += u"%d: %s (%s)\n" % (num, s.get("emoji") or u"?", s.get("set_title") or u"-")
        return body

    def _maybe_sticker(self, c, did, account, batch, parts, ack_hint, key=None, hist=None):
        """{'id', 'set', 'emoji', 'instead'} or None. With probability sticker_pct a short ai_complete 'picker' call
        decides from the chat context whether one of the recent stickers fits (strict JSON); fallback when the
        output is garbage: a sticker whose emoji matches the reply's emotion, else none. Never in groups, never for
        questions. Needs get_recent_stickers/send_sticker in the app."""
        def skip(why):
            if key:
                self._decide(key, "info", "sticker_skipped_" + why)
            return None
        try:
            if (not self.get_setting("stickers", True) or c.get("type") == "group"
                    or not hasattr(client, "get_recent_stickers") or not hasattr(client, "send_sticker")):
                return None
            pct = self._float("sticker_pct", 12.0, 0.0, 100.0)
            texts = [b[2] or "" for b in batch]
            if pct <= 0 or any(has_request(t) for t in texts):
                return None
            if self._rng.random() * 100.0 >= pct:
                return None
            lim = 25 if self.get_setting("sticker_recent", True) else 60
            lst = [s for s in (client.get_recent_stickers(limit=lim, account=account) or [])[:lim]
                   if isinstance(s, dict) and s.get("id")]
            if not lst:
                return skip("no_candidates")
            st = self._state(key) if key else None
            last_id, last_set = st.last_sticker if st else (0, "")
            fresh = [s for s in lst if s["id"] != last_id and s["id"] not in self._sticker_hist
                     and not (last_set and s.get("set_title") == last_set)]
            if not fresh:
                return skip("repeat")
            cands = list(enumerate(fresh, 1))
            media = self._media_notes(did, account, hist)
            picked, mode, err = None, "after", False
            try:
                raw = client.ai_complete([{"role": "user", "content": self._sticker_prompt(cands, texts, parts, hist, media)}],
                                         system=STICKER_SYSTEM, temperature=0.2, timeout=20)
                dec = parse_sticker_decision(raw)
            except Exception as e:
                self.log("sticker picker failed: %s" % e)
                dec = None
                err = True
            if dec is not None:
                if not dec["use"]:
                    if key:
                        self._decide(key, "info", "sticker_decided_no")
                    return None
                picked = dict(cands).get(dec["index"])
                mode = dec["mode"]
                if picked is None:
                    return skip("bad_index")
            else:                                   # garbage or no answer: only an emoji that matches the reply
                want = set()
                for t in parts:
                    want |= sticker_emojis(t)
                picked = emoji_match_sticker(fresh, want)
                if picked is None:
                    return skip("ai_error" if err else "no_match")
            instead = (mode == "instead" and sum(len(x) for x in parts) <= 30)
            if key:
                self._decide(key, "info", "sticker_decided_yes", x=picked.get("emoji") or "")
            return {"id": int(picked["id"]), "set": picked.get("set_title") or "",
                    "emoji": picked.get("emoji") or "", "instead": instead}
        except Exception as e:
            self._tl_warn("stickers", e)
            return None

    def _send_sticker(self, key, st, did, account, sticker, reply_to):
        if not self._task_alive(key, account, did):
            return False
        st.sending = True
        try:
            ok = client.send_sticker(did, sticker["id"], account=account, reply_to=reply_to)
        finally:
            st.sending = False
            st.last_send_ts = self._now()
        if ok:
            self._sticker_hist.append(sticker["id"])
            st.last_sticker = (sticker["id"], sticker.get("set") or "")
            self._decide(key, "info", "sticker_sent")
        return bool(ok)

    def deliver(self, key, c, st, did, parts, batch, humanize, timing=None, sticker=None):
        """Send the parts one by one with a short typing delay (or the human timing); raises on send failure.
        Returns False when the delivery was stopped while waiting (st.abort has the reason)."""
        parts = list(parts)
        bodies = list(parts)
        if parts and self.get_setting("disclosure", True) and not c.get("disclosed"):
            parts[0] = str(self.get_setting("disclosure_text", ROBOT + " ")) + parts[0]
        reply_to = batch[-1][0] if (c.get("type") == "group" and batch) else None
        account = int(c.get("account", 0))
        cap = self._pnum("typing_cap", 0, 15)
        budget = cap
        sent = []
        st.abort = ""
        if timing is not None and not self._live_wait(key, c, st, did, account, timing):
            return False
        st.sending = timing is None
        try:
            for i, part in enumerate(parts):
                if timing is None:
                    if self.get_setting("typing_delay", True):
                        d = typing_delay_s(part, self._rng.uniform(0.85, 1.2), cap)
                        if i == 0:
                            d = max(d, min(MIN_TYPING_TOTAL, cap))
                        d = max(0.0, min(budget, d))
                        budget -= d
                        if d > 0:
                            time.sleep(d)
                elif i:
                    gap = self._rng.uniform(self._pnum("split_gap_min", 0, 60),
                                            max(self._pnum("split_gap_min", 0, 60), self._pnum("split_gap_max", 0, 60)))
                    if self.get_setting("show_typing", True):
                        self._send_typing(did, account)
                    time.sleep(gap)
                if i:
                    cur = self._chats.get(key)
                    if not cur or not cur.get("enabled") or not self.get_setting("master", True):
                        break
                if not self._task_alive(key, account, did):
                    st.abort = "disabled meanwhile"
                    return False
                self._remember_bot_text(bodies[i])     # before sending: our own outgoing event must be recognized
                st.sending = True
                try:
                    self.send(did, part, reply_to if i == 0 else None, account=account)
                finally:
                    st.sending = timing is None
                st.last_send_ts = self._now()
                sent.append(part)
                with self._lock:
                    c["disclosed"] = True
            if sticker and self._task_alive(key, account, did):
                if sent and timing is not None:
                    time.sleep(self._rng.uniform(1.0, 3.0))
                if self._send_sticker(key, st, did, account, sticker, reply_to if not sent else None):
                    sent.append(u"[sticker]")
        finally:
            st.sending = False
            if sent:
                with self._lock:
                    now = self._now()
                    st.replies.append(now)
                    st.sent_h.append(now)
                    st.last_act_ts = st.last_reply_ts = now
                    texts = [x for x in sent if x != u"[sticker]"]
                    if texts:
                        st.recent.append(norm_text(" ".join(texts)))
        return True

    def send(self, did, text, reply_to, account=None):
        if account is not None:
            try:
                return client.send_text(did, text, reply_to=reply_to, account=int(account))
            except TypeError:
                # Old apps have no explicit account parameter. Never fall back into a different account.
                if int(client.current_account()) != int(account):
                    raise RuntimeError("Explicit-account send is unavailable")
        if reply_to is not None:
            try:
                return client.send_text(did, text, reply_to=reply_to)
            except TypeError:
                pass
        return client.send_text(did, text)

    @staticmethod
    def clean_reply(reply):
        if not isinstance(reply, str):
            return ""
        r = reply.strip()
        if len(r) > MAX_REPLY_CHARS:
            r = r[:MAX_REPLY_CHARS].rstrip() + "…"
        return r

    # ------------------------------------------------------------------ generation
    def _custom_prompt(self, key):
        p = str(self.get_setting("prompt_" + self._sk(key), "") or "").strip()
        return p or str(self.get_setting("default_prompt", "") or "").strip()

    def build_system(self, key, profile):
        """System prompt: anti-AI rules + tone + learned style + examples + owner's own prompt."""
        if not self._humanize():
            return self._chat_prompt(key)
        try:
            tone = int(self.get_setting("tone", 0))
        except (TypeError, ValueError):
            tone = 0
        parts = [HUMAN_PROMPT, TONE_RULES[tone if 0 <= tone < len(TONE_RULES) else 0],
                 DISCLOSE_RULE if self.get_setting("disclosure", True) else NO_DISCLOSE_RULE]
        c = self._chats.get(key) or {}
        if c.get("type") == "group":
            parts.append("This is a group chat; messages are labelled [user ID] only so you can "
                         "tell people apart. Answer the latest one briefly.")
        style = (profile or {}).get("style") or {}
        rules = style_rules(style)
        if rules:
            parts.append("How the owner writes (measured on their last %d messages):\n- %s"
                         % (style.get("n", 0), "\n- ".join(rules)))
        ex = ((profile or {}).get("examples") or [])[-24:]
        if ex:
            parts.append("Examples of the owner's real messages. Imitate the voice and rhythm; "
                         "never copy or quote them:\n" + "\n".join("- " + e for e in ex))
        custom = self._custom_prompt(key)
        if custom and custom != DEFAULT_PROMPT:
            parts.append("Extra instructions from the owner (they refine the rules above):\n" + custom)
        return "\n\n".join(parts)

    def _own_texts(self, account, did, limit=100):
        """Owner's eligible outgoing texts in one chat, oldest first."""
        hist = client.get_recent_messages(did, limit=limit, account=account) or []
        prefix = str(self.get_setting("disclosure_text", ROBOT + " ") or "").strip().lower()
        out, seen = [], set()
        for h in sorted((h for h in hist if isinstance(h, dict)),
                        key=lambda h: (h.get("date") or 0, h.get("id") or 0)):
            if not h.get("out") or h.get("is_service") or h.get("fwd") or h.get("forwarded"):
                continue
            t = str(h.get("text") or "").strip()
            low = t.lower()
            if not eligible_example(t) or norm_text(t)[:160] in self._bot_texts:
                continue
            if any(mk in low for mk in AUTO_MARKERS) or (prefix and low.startswith(prefix)):
                continue
            nk = norm_text(t)
            if nk in seen:
                continue
            seen.add(nk)
            out.append(t)
        return out

    def get_profile(self, key, account, did):
        """Style profile of the owner (cached per chat). Empty profile if learning is off."""
        if not self.get_setting("learn_style", True):
            return {}
        n = self._int("learn_n", 40, 5, 50)
        ttl = self._int("style_cache_min", 30, 0, 1440) * 60
        now = self._now()
        with self._lock:
            ent = self._profiles.get(key)
            if ent and ent[1] == n and now - ent[0] < ttl:
                return ent[2]
        prof = {}
        try:
            own = self._own_texts(account, did)
            texts = own[-n:]
            if len(own) < MIN_OWN:                  # few messages here: borrow from other allowed chats
                extra = []
                for k, oc in sorted(self._chats.items()):
                    if k == key or not oc.get("enabled"):
                        continue
                    try:
                        extra += self._own_texts(int(oc.get("account", 0)), int(oc["dialog_id"]), 60)
                    except Exception as e:
                        self.log("style borrow failed for %s: %s" % (k, e))
                    if len(extra) + len(own) >= n:
                        break
                texts = extra[-(n - len(own)):] + own if n > len(own) else own[-n:]
            prof = {"examples": texts[-n:], "style": compute_style(texts[-n:])}
        except Exception as e:
            self.log("style learning failed for %s: %s" % (key, e))
        with self._lock:
            self._profiles[key] = (now, n, prof)
        return prof

    def generate(self, key, account, did, messages, c, st, split=True, extra_system="", lang_text=None):
        """Returns (parts, why). Normal success: (parts, ''). Best-effort fallback after the retry:
        (parts, 'fallback'). Empty parts only for: 'empty' (no text at all) or 'duplicate reply'
        (identical to our previous reply). st is the ChatState used for de-duplication (None = off)."""
        model = str(self.get_setting("model", "") or "").strip()
        if not self._humanize():
            legacy_lang = ""
            if self._reply_lang_mode(key) or extra_system:      # the old plain mode only follows an explicit choice
                plain_in = LABEL_RE.sub("", str(messages[-1].get("content") or "")) if messages else ""
                legacy_lang = "\n\n" + lang_rule(self.pick_reply_lang(
                    key, account, did, plain_in if lang_text is None else str(lang_text)))
            kwargs = {"system": self._chat_prompt(key) + ("\n\n" + extra_system if extra_system else "")
                      + legacy_lang,
                      "timeout": 60}
            if model:
                kwargs["model"] = model
            reply = self.clean_reply(self._complete_for_chat(key, account, did, messages, **kwargs))
            return ([reply] if reply else []), "empty"
        profile = self.get_profile(key, account, did)
        last_in = LABEL_RE.sub("", str(messages[-1].get("content") or "")) if messages else ""
        if lang_text is not None:
            last_in = str(lang_text)
        batch_in, recent_in = self._incoming_texts(messages, lang_text)
        lang = self.pick_reply_lang(key, account, did, last_in, batch=batch_in, recent=recent_in)
        system = self.build_system(key, profile) + ("\n\n" + extra_system if extra_system else "") + (
            "\n\n" + lang_rule(lang, follow_other=self._reply_lang_mode(key) == 3))
        temp = self._float("temperature", 0.95, 0.0, 2.0)
        limit = self._int("max_reply", 300, 40, MAX_REPLY_CHARS)
        style = (profile or {}).get("style") or {}
        extra = self._banned_extra()
        split_min = int(self._pnum("split_min", 40, 1500)) if self._explicit("split_min") else SPLIT_MIN_CHARS
        cands = []                                  # (parts, problems)
        problems = []
        for attempt in range(2):
            kwargs = {"system": system, "timeout": 60, "temperature": min(2.0, temp + 0.1 * attempt)}
            if model:
                kwargs["model"] = model
            if attempt:
                kwargs["system"] = system + (
                    "\n\nYour previous attempt was rejected (%s). Write a clearly different, shorter, "
                    "more casual message in %s, plain everyday words, without any of the banned words "
                    "and phrases." % (", ".join(problems) or "too formal", lang))
            reply = clean_humanized(self._complete_for_chat(key, account, did, messages, **kwargs), limit)
            if not reply:
                problems = ["empty"]
                continue
            if split and self.get_setting("split_msgs", True) and len(reply) > split_min:
                raw = split_reply(reply, 2)
            else:
                raw = [reply]
            parts = [p for p in (apply_style(p, style) for p in raw) if p]
            if not parts:
                problems = ["empty"]
                continue
            problems = self.reply_problems(" ".join(parts), st, last_in, extra)
            cands.append((parts, problems))
            if not problems:
                return parts, ""
        if not cands:
            return [], "empty"
        usable = [cd for cd in cands if not any(p == "repeat" for p in cd[1])]
        if not usable:
            return [], "duplicate reply"
        # best available: no AI-tell / wrong language first, then fewest banned hits
        usable.sort(key=lambda cd: (any(p in ("ai-tell", "wrong-lang") for p in cd[1]), len(cd[1])))
        return usable[0][0], "fallback"

    @staticmethod
    def _incoming_texts(messages, lang_text=None):
        """(texts being answered = the trailing user messages, last 3 user texts), oldest first."""
        users = [LABEL_RE.sub("", str(m.get("content") or "")) for m in (messages or []) if m.get("role") == "user"]
        tail = []
        for m in reversed(messages or []):
            if m.get("role") != "user":
                break
            tail.insert(0, LABEL_RE.sub("", str(m.get("content") or "")))
        if lang_text is not None:
            tail = [str(lang_text)]
        return tail, users[-3:]

    def reply_problems(self, text, st, last_in="", extra=()):
        """List of problems: 'banned:<words>', 'ai-tell', 'wrong-lang', 'repeat' (same as our last reply)."""
        out = []
        tell = STRONG_TELL_RE if self.get_setting("disclosure", True) else AI_TELL_RE
        if tell.search(text):
            out.append("ai-tell")
        hits = banned_hits(text, extra)
        if hits:
            out.append("banned:" + ",".join(hits[:4]))
        if CJK_RE.search(text) and not CJK_RE.search(last_in or ""):
            out.append("wrong-lang")
        else:
            letters = [ch for ch in text if ch.isalpha()]
            if (len(letters) >= 8 and re.search(u"[Ѐ-ӿ]", last_in or "")
                    and sum(1 for ch in letters if ch.isascii()) > 0.7 * len(letters)):
                out.append("wrong-lang")
        n = norm_text(text)
        if st is not None and len(n) >= 12 and st.recent:
            prev = st.recent[-1]
            if prev == n or (not self._live() and difflib.SequenceMatcher(None, prev, n).ratio() >= 0.95):
                out.append("repeat")
        return out

    def reply_problem(self, text, st):
        p = self.reply_problems(text, st)
        return p[0] if p else ""

    def _hist_messages(self, c, hist):
        group = c.get("type") == "group"
        out = []
        for h in hist:
            role = "assistant" if h.get("out") else "user"
            text = str(h["text"]).strip()
            if group and role == "user":
                text = "[user %s] %s" % (h.get("from_id"), text)
            out.append({"role": role, "content": text})
        while out and out[0]["role"] == "assistant":
            out.pop(0)
        return out

    def _load_history(self, key, account, did, n):
        hist = []
        try:
            hist = client.get_recent_messages(did, limit=n, account=account) or []
        except Exception as e:
            self.log("history unavailable for %s: %s" % (key, e))
        return sorted((h for h in hist if isinstance(h, dict) and str(h.get("text") or "").strip()),
                      key=lambda h: (h.get("date") or 0, h.get("id") or 0))[-n:]

    def build_messages(self, key, account, did, batch, hist=None):
        n = self._int("context_n", 10, 1, 40)
        if hist is None:
            hist = self._load_history(key, account, did, n)
        c = self._chats.get(key) or {}
        group = c.get("type") == "group"
        out = self._hist_messages(c, hist)
        ids = set(h.get("id") for h in hist)
        for mid, fid, text in batch:          # make sure the new messages are present
            if mid not in ids and text:
                out.append({"role": "user",
                            "content": ("[user %s] %s" % (fid, text)) if group else text})
        if not out or out[-1]["role"] != "user":
            return []
        return out

    # ------------------------------------------------------------------ style test
    def on_test_style(self, dialog_id, title=""):
        """DialogPicker callback (UI thread): the test itself runs in a worker."""
        try:
            try:
                account = int(client.current_account())
            except Exception:
                account = 0
            self.start_style_test(account, int(dialog_id), title)
        except Exception as e:
            self.error(e)

    def start_style_test(self, account, did, title=""):
        if self._testing and self._now() - self._testing_ts < 180:
            client.bulletin(self.t("bl_test_running"))
            return False
        self._testing = True
        self._testing_ts = self._now()

        def work():
            try:
                self.run_style_test(account, did, title)
            except Exception as e:
                self.error(e)
                client.bulletin(self.t("bl_test_failed", e))
            finally:
                self._testing = False
        client.run_in_bg(work)
        return True

    def run_style_test(self, account, did, title=""):
        """Generates a sample reply to each of the last 5 incoming messages. Nothing is sent."""
        info = client.get_dialog_info(did)
        reason = self.check_info(info)
        if reason:
            client.bulletin(self.t("bl_test_na", self.rt(reason)))
            return []
        key = self.chat_key(account, did)
        c = {"type": info.get("type")}
        n = self._int("context_n", 10, 1, 40)
        hist = self._load_history(key, account, did, 60)
        idx = [i for i, h in enumerate(hist) if not h.get("out") and not h.get("is_bot")][-5:]
        if not idx:
            client.bulletin(self.t("bl_test_noinc"))
            return []
        profile = self.get_profile(key, account, did)
        lines = []
        for i in idx:
            msgs = self._hist_messages(c, hist[max(0, i + 1 - n):i + 1])
            if not msgs or msgs[-1]["role"] != "user":
                continue
            parts, why = self.generate(key, account, did, msgs, c, None, split=True)
            shown = " || ".join(parts) if parts else self.t("test_no_reply", self.rt(why))
            lines.append("%d) %s\n   -> %s" % (len(lines) + 1, str(hist[i]["text"]).strip()[:120], shown))
        if not lines:
            client.bulletin(self.t("bl_test_nothing"))
            return []
        learned = len((profile or {}).get("examples") or [])
        text = self.t("test_result", info.get("title") or title or did, learned, "\n".join(lines))
        self.set_setting("style_test_result", text)
        self._decide(self.chat_key(account, did), "test", "style_test_done")
        client.bulletin(text[:900])
        return lines

    # ------------------------------------------------------------------ localization helpers
    def lang(self):
        try:
            i = int(self.get_setting("ui_lang", 0))
        except (TypeError, ValueError):
            i = 0
        if i in (1, 2, 3):
            return ("", "uk", "ru", "en")[i]
        return app_ui_lang() or "uk"

    def t(self, key, *args):
        text = tr(self.lang(), key)
        if args:
            try:
                return text % args
            except (TypeError, ValueError):
                return text
        return text

    def rt(self, reason):
        """Localized plain-language text of a reason (raw reason string or stored code)."""
        code = re.sub(r"\W+", "_", str(reason).lower()).strip("_")
        return reason_text(self.lang(), code)

    # ------------------------------------------------------------------ decision log view
    def _chat_title(self, key):
        """Chat title for the log: plugin list, cache, get_dialog_info; the id when nothing is known."""
        key = str(key)
        c = self._chats.get(key)
        if c and c.get("title"):
            return str(c["title"])
        if key in self._titles:
            return self._titles[key]
        try:
            acc, did = key.split(":", 1)
            info = client.get_dialog_info(int(did), account=int(acc))
            title = str((info or {}).get("title") or "").strip()
        except Exception:
            title = ""
        if title:
            self._titles[key] = title
            return title
        return key.split(":", 1)[-1]

    def decision_sentence(self, r):
        outcome, code = str(r.get("o") or ""), str(r.get("r") or "")
        label = self.t("o_" + outcome) if ("o_" + outcome) in S else outcome
        if outcome in ("sent", "draft") and code == "ok":
            return label
        if outcome in ("seen", "cmd", "info"):
            return self.rt(code) + ((" " + str(r["x"])) if r.get("x") else "")
        return "%s: %s" % (label, self.rt(code))

    def _stamp(self, ts, full=False):
        try:
            lt = time.localtime(float(ts))
            same_day = time.strftime("%Y-%m-%d", lt) == time.strftime("%Y-%m-%d", time.localtime(self._now()))
            return time.strftime("%H:%M:%S" if same_day and not full else "%d.%m %H:%M:%S", lt)
        except Exception:
            return "?"

    def decision_rows(self):
        """[(title, sentence, record)] newest first, at most 40. Title like '21:45:30 · Cherish'."""
        rows = list(getattr(self, "_decisions", []))[-40:][::-1]
        return [("%s · %s" % (self._stamp(r.get("t", 0)), self._chat_title(r.get("chat"))),
                 self.decision_sentence(r), r) for r in rows]

    def log_for_clipboard(self):
        rows = list(getattr(self, "_decisions", []))[-40:][::-1]
        out = []
        for r in rows:
            out.append("%s · %s — %s [%s/%s]" % (self._stamp(r.get("t", 0), True), self._chat_title(r.get("chat")),
                                                  self.decision_sentence(r), r.get("o"), r.get("r")))
        return "\n".join(out)

    def copy_log(self):
        text = self.log_for_clipboard()
        if not text:
            client.bulletin(self.t("bl_log_empty"))
            return False
        client.copy_to_clipboard(text)
        client.bulletin(self.t("bl_copied", len(text.splitlines())))
        return True

    def clear_log(self):
        with self._lock:
            self._decisions.clear()
            self.set_setting("decisions", "[]")
        client.bulletin(self.t("bl_cleared"))

    # ------------------------------------------------------------------ "bot writes first" owner command
    def _cmd_triggers(self):
        raw = str(self.get_setting("cmd_triggers", "") or "").strip() or DEFAULT_TRIGGERS
        found = {fold_cmd(x.strip()) for x in re.split(r"[,;\n]", raw) if x.strip()}
        return sorted(found, key=len, reverse=True) or [".ai"]

    def parse_command(self, text):
        """-> (to_draft, topic) when the text is exactly the owner's command, else None."""
        t = str(text or "").strip()
        low = fold_cmd(t)
        for trig in self._cmd_triggers():
            if low == trig or (low.startswith(trig) and (low[len(trig)].isspace() or low[len(trig)] == "?")):
                rest = t[len(trig):].strip()
                draft = False
                head = rest.split(None, 1)
                if head and head[0].lower() in DRAFT_WORDS:
                    draft, rest = True, (head[1] if len(head) > 1 else "")
                elif rest.startswith("?"):
                    draft, rest = True, rest[1:].strip()
                return draft, rest[:500].strip()
        return None

    @staticmethod
    def _has_media(params):
        # NOT sendAnimationData / mediaWebPage / entities: the input field sets them on every plain text.
        for a in ("photo", "document", "location", "poll", "game", "invoice", "user", "todo",
                  "retryMessageObject", "videoEditedInfo", "richMessage"):
            if getattr(params, a, None) is not None:
                return True
        return bool(getattr(params, "path", None))

    def _private_ok(self, did):
        try:
            info = client.get_dialog_info(did)
        except Exception:
            return False
        return isinstance(info, dict) and info.get("type") == "user" and self.check_info(info) is None

    def _command_gate(self, account, did, key, cmd, via):
        """Shared checks for every command attempt. Returns a reason code when it must not run (logged)."""
        if not self.get_setting("cmd_enable", True):
            self._decide(key, "skip", "command_disabled")
            return "command_disabled"
        if not (self.is_enabled(key) or (self.get_setting("cmd_any_private", False) and did > 0
                                         and self._private_ok(did))):
            self._decide(key, "skip", "chat_not_listed")
            return "chat_not_listed"
        if not self.get_setting("master", True):
            self._decide(key, "skip", "master_off")
            client.bulletin(self.t("bl_cmd_master"))
            return "master_off"
        return None

    def _start_command(self, account, did, key, draft, topic):
        """Runs the command in a worker. Returns False when the previous one is still running."""
        with self._lock:
            busy = key in self._cmd_busy
            self._cmd_busy.add(key)
        if busy:
            self._decide(key, "skip", "owner_command_busy")
            client.bulletin(self.t("bl_cmd_busy"))
            return False
        try:
            client.run_in_bg(lambda: self.run_command(int(account), did, key, draft, topic))
        except Exception as e:
            self._cmd_busy.discard(key)
            self.log("command could not start: %s" % e)
            self._decide(key, "error", "owner_command_ai_failed")
            client.bulletin(self.t("bl_cmd_failed", e))
        return True

    def on_send_message_hook(self, account, params):
        """Intercepts the owner's own '.ai' command: cancelled (never sent), the work runs in a worker."""
        try:
            text = getattr(params, "message", None)
            if text is None:
                return None
            text = str(text)
            adm = self.parse_admin(text)
            cmd = None if adm else self.parse_command(text)
            if cmd is None and adm is None:
                return None
            did = int(getattr(params, "peer", 0) or 0)
            if not did:
                return None
            key = self.chat_key(account, did)
            self._cmd_seen[key] = self._now()
            if self._has_media(params):
                self._decide(key, "skip", "command_ignored_media")
                return None
            if adm:
                if not self.get_setting("cmd_enable", True):
                    self._decide(key, "skip", "command_disabled")
                    return None
                self._start_admin(account, did, key, adm)
                return HookResult(strategy=HookStrategy.CANCEL)
            gate = self._command_gate(account, did, key, cmd, "hook")
            if gate == "master_off":
                return HookResult(strategy=HookStrategy.CANCEL)
            if gate:
                return None                      # not a chat of the plugin / disabled: an ordinary message
            draft, topic = cmd
            self._start_command(account, did, key, draft, topic)
            return HookResult(strategy=HookStrategy.CANCEL)
        except Exception as e:
            self.error(e)
            try:
                self._decide("?", "error", "command_hook_exception")
            except Exception:
                pass
            return None

    def _outgoing_command_fallback(self, account, did, key, m, admin_only=False):
        """The send hook did not see this '.ai' (old app / other send path): the message is already in the
        chat, so we cannot cancel it, but the command still works."""
        text = str(m.get("text") or "")
        if not text or self._is_bot_text(text):
            return
        adm = self.parse_admin(text)
        cmd = None if adm else (None if admin_only else self.parse_command(text))
        if cmd is None and adm is None:
            return
        now = self._now()
        if now - self._cmd_seen.get(key, 0.0) < 30 or now - self._cmd_fallback.get(key, 0.0) < 30:
            return
        d = m.get("date")
        if d is not None and now - float(d) > MAX_AGE_SEC:
            return
        self._cmd_fallback[key] = now
        self._decide(key, "skip", "owner_command_hook_missed")
        if adm:
            if not self.get_setting("cmd_enable", True):
                self._decide(key, "skip", "command_disabled")
                return
            self._start_admin(account, did, key, adm)
            return
        if self._command_gate(account, did, key, cmd, "outgoing"):
            return
        draft, topic = cmd
        self._start_command(account, did, key, draft, topic)

    # ---- in-chat admin commands: .ai on | off | status | list | mode auto|draft|friend
    def parse_admin(self, text):
        """-> (verb, arg) when the text is exactly one of the admin commands, else None."""
        t = str(text or "").strip()
        low = fold_cmd(t)
        for trig in self._cmd_triggers():
            if low.startswith(trig) and len(low) > len(trig) and low[len(trig)].isspace():
                words = low[len(trig):].split()
                verb = ADMIN_VERBS.get(words[0]) if words else None
                if verb is None:
                    return None
                if verb == "mode":
                    if len(words) > 2:
                        return None
                    return ("mode", words[1] if len(words) == 2 else "")
                return (verb, "") if len(words) == 1 else None
        return None

    def _start_admin(self, account, did, key, adm):
        def work():
            self.run_admin(int(account), did, key, adm)
        try:
            client.run_in_bg(work)
        except Exception as e:
            self.log("admin command could not start: %s" % e)
            self._decide(key, "error", "command_hook_exception")

    def run_admin(self, account, did, key, adm):
        try:
            self._run_admin(account, did, key, adm[0], adm[1])
        except Exception as e:
            self.error(e)
            self._decide(key, "error", "command_hook_exception")
            client.bulletin(self.t("bl_cmd_failed", e))

    @staticmethod
    def private_reason(info):
        """Reason why a chat is not a private chat with a person (None = ok): secret/channel/bot/group/..."""
        reason = Plugin.check_info(info)
        if reason:
            return reason
        return None if info.get("type") == "user" else "group"

    def _mode_label(self, mode):
        return self.t("ms_%d" % mode) if mode in (0, 1, 2) else str(mode)

    def _last_for(self, key):
        """Newest real decision of a chat as 'HH:MM:SS sentence' (incoming_seen entries do not count)."""
        for r in reversed(list(self._decisions)):
            if r.get("chat") == key and r.get("o") not in ("seen", "cmd"):
                return "%s %s" % (self._stamp(r.get("t", 0)), self.decision_sentence(r))
        return self.t("no_last")

    def _active_titles(self):
        out = []
        for k, c in sorted(self._chats.items()):
            if c.get("enabled"):
                out.append("%s (%s)" % (self._title_of(k, c), self._mode_label(self._chat_mode(k))))
        return out

    def _title_of(self, key, c):
        return str((c or {}).get("title") or key)

    def _run_admin(self, account, did, key, verb, arg):
        master = "" if self.get_setting("master", True) else self.t("bl_adm_master")
        if verb == "list":
            names = self._active_titles()
            self._decide(key, "cmd", "admin_list")
            if not names:
                client.bulletin(self.t("bl_adm_list_none") + master)
                return
            shown = ", ".join(names[:8]) + (" +%d" % (len(names) - 8) if len(names) > 8 else "")
            client.bulletin(self.t("bl_adm_list", len(names), shown) + master)
            return
        try:
            info = client.get_dialog_info(did)
        except Exception:
            info = None
        c = self._chats.get(key)
        if verb == "on":
            reason = self.private_reason(info) if isinstance(info, dict) else "unknown chat"
            if reason:
                self._decide(key, "cmd", "admin_refused")
                client.bulletin(self.t("bl_adm_private", self.rt(reason)))
                return
            new = c is None or not c.get("enabled")
            c = self.chat_on(account, did, str(info.get("title") or did), "user")
            self._decide(key, "cmd", "admin_on")
            mode = self._chat_mode(key)
            if new and mode == MODE_AUTO:
                client.bulletin(self.t("bl_adm_on", c["title"]) + master)
            else:
                client.bulletin(self.t("bl_adm_on_again", c["title"], self._mode_label(mode)) + master)
            return
        if verb == "off":
            title = self.chat_off(key, remove=True)
            if title is None:
                self._decide(key, "cmd", "admin_off_none")
                client.bulletin(self.t("bl_adm_off_none"))
                return
            self._decide(key, "cmd", "admin_off")
            client.bulletin(self.t("bl_adm_off", title))
            return
        if verb == "status":
            self._decide(key, "cmd", "admin_status")
            if c is None:
                title = str((info or {}).get("title") or did) if isinstance(info, dict) else str(did)
                client.bulletin(self.t("bl_adm_status_off", title) + master)
                return
            fmt = "bl_adm_status_on" if c.get("enabled") else "bl_adm_status_paused"
            client.bulletin(self.t(fmt, self._title_of(key, c), self._mode_label(self._chat_mode(key)),
                                   self._last_for(key)) + master)
            return
        if verb == "mode":
            if c is None:
                self._decide(key, "cmd", "admin_mode_unlisted")
                client.bulletin(self.t("bl_adm_mode_unlisted"))
                return
            mode = ADMIN_MODES.get(arg)
            if mode is None:
                self._decide(key, "cmd", "admin_mode_bad")
                client.bulletin(self.t("bl_adm_mode_bad"))
                return
            self.set_setting("mode_" + self._sk(key), mode)
            self._decide(key, "cmd", "admin_mode_" + ("auto", "draft", "friend")[mode])
            client.bulletin(self.t("bl_adm_mode", self._title_of(key, c), self._mode_label(mode)))

    def cond_show_cmd(self, ctx):
        try:
            did = ctx.get("dialog_id") or 0
            return bool(did) and bool(self.get_setting("cmd_enable", True)) and                 self.is_enabled(self.chat_key(ctx.get("account"), did))
        except Exception:
            return False

    def on_cmd_click(self, ctx):
        account, did = int(ctx.get("account") or 0), int(ctx.get("dialog_id") or 0)
        if not did:
            return
        key = self.chat_key(account, did)
        self._cmd_seen[key] = self._now()
        if self._command_gate(account, did, key, (False, ""), "menu"):
            return
        self._start_command(account, did, key, False, "")

    def run_command(self, account, did, key, draft, topic):
        try:
            self._run_command(account, did, key, draft, topic)
        except Exception as e:
            self.error(e)
            self._decide(key, "error", "owner_command_ai_failed")
            client.bulletin(self.t("bl_cmd_failed", e))
        finally:
            self._cmd_busy.discard(key)

    def _openers(self, code="uk"):
        """Your own list (any language) or the built-in one in the chat's language (uk / ru)."""
        raw = str(self.get_setting("cmd_openers", "") or "")
        items = [x.strip() for x in re.split(r"[\n;]", raw) if x.strip()]
        return items or list(DEFAULT_OPENERS_RU if code == "ru" else DEFAULT_OPENERS)

    # ---- reply language
    def _reply_lang_mode(self, key):
        """0 auto, 1 Ukrainian, 2 Russian, 3 the other person's language. Per chat ('rlang_<sk>', 0 = follow
        the global 'reply_lang') over global."""
        try:
            per = int(self.get_setting("rlang_" + self._sk(key), 0))
        except (TypeError, ValueError):
            per = 0
        if per in (1, 2, 3, 4):
            return per - 1
        try:
            g = int(self.get_setting("reply_lang", 3))
        except (TypeError, ValueError):
            g = 3
        return g if g in (0, 1, 2, 3) else 3

    def pick_reply_lang(self, key, account, did, last_in="", batch=None, recent=None):
        """'Ukrainian' / 'Russian' / 'English' to answer in. Auto: from the last ~15 messages of the chat
        (the owner's own count most), cached 10 minutes per chat; no signal: the language of last_in,
        Ukrainian by default."""
        mode = self._reply_lang_mode(key)
        if mode == 1:
            return "Ukrainian"
        if mode == 2:
            return "Russian"
        if mode == 3:                                # the other person's language, the current message first
            found = incoming_language(batch if batch is not None else [last_in],
                                      recent if recent is not None else [last_in])
            if found:
                return found
            try:
                hist = self._load_history(key, account, did, 15)
                own = [str(h.get("text") or "") for h in hist
                       if h.get("out") and not h.get("is_service") and not self._is_bot_text(h.get("text"))]
                found = context_language(own, [])
            except Exception as e:
                self.log("language detection failed for %s: %s" % (key, e))
            return found or detect_lang(last_in)
        now = self._now()
        ent = self._lang_cache.get(key)
        if ent and now - ent[0] < 600:
            found = ent[1]
        else:
            found = None
            try:
                hist = self._load_history(key, account, did, 15)
                own = [str(h.get("text") or "") for h in hist
                       if h.get("out") and not h.get("is_service") and not self._is_bot_text(h.get("text"))]
                inc = [str(h.get("text") or "") for h in hist if not h.get("out")]
                found = context_language(own, inc)
            except Exception as e:
                self.log("language detection failed for %s: %s" % (key, e))
            self._lang_cache[key] = (now, found)
        return found or detect_lang(last_in)

    def _run_command(self, account, did, key, draft, topic):
        try:
            info = client.get_dialog_info(did)
        except Exception:
            info = None
        reason = self.check_info(info) if info is not None else None
        if reason:
            self._decide(key, "skip", "owner_command_not_allowed")
            client.bulletin(self.t("bl_cmd_na", self.rt(reason)))
            return
        c = dict(self._chats.get(key) or {"type": (info or {}).get("type") or "user"})
        st = self._state(key)
        to_draft = bool(draft) or self._int("cmd_mode", 0, 0, 1) == 1
        now = self._now()
        hist = [h for h in self._load_history(key, account, did, 15)
                if h.get("date") is None or now - float(h.get("date") or 0) <= 86400]
        msgs = self._hist_messages(c, hist)
        if hist and not msgs:                    # only the owner's own messages are fresh
            msgs = [{"role": "assistant" if h.get("out") else "user", "content": str(h["text"]).strip()}
                    for h in hist]
        inc_texts = [str(h["text"]) for h in hist if not h.get("out")]
        lang_text = inc_texts[-1] if inc_texts else (str(hist[-1]["text"]) if hist else topic)
        opener = ""
        if topic:
            kind = "owner_command_topic"
            instr = ("Write the next message from me to the other person about this: %s. If it continues the "
                     "conversation above make it fit naturally, otherwise it is a first message. Use only facts "
                     "from the conversation or from this instruction." % topic)
        elif hist:
            kind = "owner_command"
            instr = ("Continue the conversation naturally as me. If the other person's last message is still "
                     "unanswered, answer it. Otherwise gently bring up something relevant from the conversation "
                     "or ask a short follow-up. One short message.")
        else:
            kind = "owner_command_opener"
            ctx_lang = self.pick_reply_lang(key, account, did, topic or "")
            opener = self._rng.choice(self._openers("ru" if ctx_lang == "Russian" else "uk"))
            instr = ("There is no recent conversation. Open one with a short casual message that means: '%s'. "
                     "Say it in my own style; add no facts and no extra questions." % opener)
        parts, why = [], ""
        if opener and not self._humanize():
            parts = [opener]
        else:
            msgs = msgs + [{"role": "user", "content": "[private instruction from me, not from them: %s]" % instr}]
            try:
                parts, why = self.generate(key, account, did, msgs, c, st, split=not to_draft,
                                           extra_system=CMD_RULES, lang_text=lang_text)
            except Exception as e:
                self.log("command generation failed in %s: %s" % (key, e))
                parts, why = [], "ai failed"
            if not parts and opener:
                parts = [opener]
        if not parts:
            self._decide(key, "error", "owner_command_ai_failed")
            client.bulletin(self.t("bl_cmd_failed", self.rt(why or "ai failed")))
            return
        for p in parts:
            self._remember_bot_text(p)
        if to_draft:
            client.set_draft(did, "\n".join(parts))
            self._decide(key, "draft", kind)
            client.bulletin(self.t("bl_cmd_draft"))
            return
        cap = self._pnum("typing_cap", 0, 15)
        st.sending = True
        try:
            for i, part in enumerate(parts):
                if self.get_setting("typing_delay", True):
                    d = typing_delay_s(part, self._rng.uniform(0.85, 1.2), cap)
                    if d > 0:
                        time.sleep(d)
                self.send(did, part, None)
        except Exception as e:
            self.log("command send failed in %s: %s" % (key, e))
            self._decide(key, "error", "owner_command_send_failed")
            client.bulletin(self.t("bl_cmd_failed", e))
            return
        finally:
            st.sending = False
        with self._lock:
            st.recent.append(norm_text(" ".join(parts)))
        self._decide(key, "sent", kind)

    # ------------------------------------------------------------------ settings
    def _text_row(self, text, key, on_click, subtext=None):
        try:
            return Text(text=text, key=key, on_click=on_click, subtext=subtext)
        except TypeError:                   # an older app without Text(subtext=...)
            return Text(text=("%s - %s" % (text, subtext)) if subtext else text, key=key, on_click=on_click)

    def _fresh_title(self, key, c):
        """Chat title: stored one, else from the app's dialog info (cache only)."""
        title = str(c.get("title") or "")
        if title and title != str(c.get("dialog_id")):
            return title
        try:
            info = client.get_dialog_info(int(c.get("dialog_id") or 0), account=int(c.get("account", 0)))
            new = str((info or {}).get("title") or "").strip()
        except Exception:
            new = ""
        if new:
            c["title"] = new
            self._commit(key, set={"title": new})
            return new
        return title or key

    def chat_row_sub(self, key, c):
        """Second line of a chat row: mode, on/off, last decision."""
        if c.get("enabled"):
            state = self.t("st_on")
        elif c.get("auto_off_ts"):
            state = self.t("paused")
        else:
            state = self.t("st_off")
        return "%s \u00b7 %s \u00b7 %s" % (self._mode_label(self._chat_mode(key)), state,
                                           self.t("last_pref", self._last_for(key)))

    def _toggle_open(self, key):
        def cb():
            self._open_key = None if self._open_key == key else key
        return cb

    def create_settings(self):
        self._load_chats()
        t = self.t
        # 1. chats where the bot is active
        items = [Header(text=t("h_bot_chats"))]
        if not self.get_setting("master", True):
            items.append(note(t("master_off_note")))
        if self._chats:
            items.append(note(t("chats_hint")))
        else:
            items.append(note(t("no_chats")))
        if self._open_key not in self._chats:
            self._open_key = None
        for key, c in sorted(self._chats.items(), key=lambda kv: (not kv[1].get("enabled"), kv[0])):
            sk = self._sk(key)
            title = self._fresh_title(key, c)
            self.set_setting("keep_" + sk, bool(c.get("enabled")))   # keep the switch in sync with the menu
            opened = self._open_key == key
            items.append(self._text_row(("\u25be " if opened else "\u25b8 ") + title, "chat_" + sk,
                                        self._toggle_open(key), self.chat_row_sub(key, c)))
            if opened:
                items.append(Selector(key="mode_" + sk, text=t("chat_mode"),
                                      items=[t("mode_auto"), t("mode_draft"), t("mode_cmd")], default=MODE_AUTO))
                items.append(Selector(key="rlang_" + sk, text=t("chat_rlang"),
                                      items=[t("rl_chat_0")] + [t("rl_%d" % i) for i in range(4)], default=0))
                items.append(Switch(key="keep_" + sk, text=t("chat_enabled"), default=bool(c.get("enabled")),
                                    on_change=self._keep_cb(key)))
                items.append(Switch(key="see_media_" + sk, text=t("see_media"), default=False,
                                    subtext=t("media_consent"), on_change=self._media_consent_changed))
                items.append(Switch(key="transcribe_voice_" + sk, text=t("transcribe_voice"), default=False,
                                    subtext=t("voice_consent"), on_change=self._media_consent_changed))
                items.append(Input(key="prompt_" + sk, text=t("chat_prompt"), default="", multiline=True,
                                   subtext=t("chat_prompt_s")))
                items.append(Text(text=t("chat_test"), key="test_" + sk, on_click=self._test_cb(key)))
                items.append(Text(text=t("chat_remove"), key="remove_" + sk, on_click=self._remove_cb(key)))
        # 2. add a chat, right below the list
        items.append(Header(text=t("h_add")))
        if DialogPicker is not None:
            items.append(DialogPicker(key="add_pick", text=t("add_pick"), on_pick=self.on_chat_added,
                                      subtext=t("add_pick_s")))
            items.append(UsernameInput(key="add_username", text=t("add_user"), on_resolved=self.on_chat_added,
                                       subtext=t("add_user_s")))
        else:
            items.append(note(t("add_old")))
        items.append(note(t("add_cmds")))
        # 3. advanced settings
        items += [
            Header(text=t("h_general")),
            Switch(key="master", text=t("master"), default=True, subtext=t("master_s")),
            Selector(key="ui_lang", text=t("lang"), items=list(LANG_NAMES), default=0, subtext=t("lang_s")),
            Selector(key="preset", text=t("preset"), items=[t("preset_%d" % i) for i in range(4)], default=LIVE_PRESET,
                     subtext=t("preset_s")),
            Selector(key="reply_lang", text=t("reply_lang"), items=[t("rl_%d" % i) for i in range(4)], default=3,
                     subtext=t("reply_lang_s")),
            Header(text=t("h_modes")),
            note(t("modes_help")),
            Header(text=t("h_cmd")),
            note(t("cmd_note")),
            Switch(key="cmd_enable", text=t("cmd_on"), default=True, subtext=t("cmd_on_s")),
            Input(key="cmd_triggers", text=t("cmd_triggers"), default=DEFAULT_TRIGGERS, subtext=t("cmd_triggers_s")),
            Selector(key="cmd_mode", text=t("cmd_mode"), items=[t("cmd_mode_0"), t("cmd_mode_1")], default=0),
            Switch(key="cmd_any_private", text=t("cmd_any"), default=False, subtext=t("cmd_any_s")),
            Input(key="cmd_openers", text=t("cmd_openers"), default="", multiline=True, subtext=t("cmd_openers_s")),
            Header(text=t("h_humanize")),
            Switch(key="humanize", text=t("humanize"), default=True, subtext=t("humanize_s")),
            Switch(key="learn_style", text=t("learn"), default=True, subtext=t("learn_s")),
            Input(key="learn_n", text=t("learn_n"), default="40"),
            Input(key="style_cache_min", text=t("relearn"), default="30"),
            Selector(key="tone", text=t("tone"), items=[t("tone_%d" % i) for i in range(3)], default=0,
                     subtext=t("tone_s")),
            Switch(key="split_msgs", text=t("split"), default=True, subtext=t("split_s")),
            Switch(key="typing_delay", text=t("typing"), default=True, subtext=t("typing_s")),
            Input(key="typing_cap", text=t("typing_cap"), default="", subtext=t("typing_cap_s")),
            Input(key="banned_words", text=t("banned"), default="", multiline=True, subtext=t("banned_s")),
            Switch(key="skip_emoji", text=t("skip_emoji"), default=True),
            Input(key="max_reply", text=t("max_reply"), default="300"),
            Input(key="temperature", text=t("temperature"), default="0.95"),
            Header(text=t("h_prompts")),
            Input(key="default_prompt", text=t("default_prompt"), default="", multiline=True,
                  subtext=t("default_prompt_s")),
            Input(key="context_n", text=t("context_n"), default="10"),
            Input(key="model", text=t("model"), default=""),
            Switch(key="disclosure", text=t("disclosure"), default=True),
            Input(key="disclosure_text", text=t("disclosure_text"), default=ROBOT + " "),
            Input(key="trigger", text=t("trigger"), default=".ai "),
            Header(text=t("h_limits")),
            Input(key="debounce", text=t("debounce"), default="", subtext=t("debounce_s")),
            Input(key="cooldown", text=t("cooldown"), default="", subtext=t("cooldown_s")),
            Input(key="chat_hourly", text=t("chat_hourly"), default="", subtext=t("chat_hourly_s")),
            Switch(key="polite_stop", text=t("polite_stop"), default=True),
            Input(key="owner_active", text=t("owner_active"), default="", subtext=t("owner_active_s")),
            Input(key="quiet_hours", text=t("quiet"), default="", subtext=t("quiet_s")),
            Switch(key="skip_ack", text=t("skip_ack"), default=True, subtext=t("until_touch")),
            Switch(key="group_need_question", text=t("group_q"), default=True, subtext=t("until_touch")),
            Input(key="daily_cap", text=t("daily_cap"), default="", subtext=t("until_touch")),
            Input(key="hourly_cap", text=t("hourly_cap"), default="", subtext=t("until_touch")),
            Header(text=t("h_live")),
            note(t("live_note")),
            Switch(key="human_timing", text=t("human_timing"), default=True, subtext=t("until_touch")),
            Switch(key="scan", text=t("scan_on"), default=True, subtext=t("scan_on_s")),
            Switch(key="show_typing", text=t("show_typing"), default=True, subtext=t("show_typing_s")),
            Switch(key="read_msgs", text=t("read_msgs"), default=True, subtext=t("read_msgs_s")),
            Switch(key="read_always", text=t("read_always"), default=False),
            Switch(key="stickers", text=t("stickers"), default=True, subtext=t("stickers_s")),
            Input(key="sticker_pct", text=t("sticker_pct"), default="12"),
            Switch(key="sticker_recent", text=t("sticker_recent"), default=True),
            note(t("media_per_chat")),
        ] + [Input(key=k, text=t(k), default="", subtext=t("until_touch")) for k in (
            "lat_warm_min", "lat_warm_max", "lat_cold_min", "lat_cold_max", "lat_long_pct", "lat_long_min",
            "lat_long_max", "warm_window", "cold_after", "type_ms", "warm_cap", "split2_pct", "split_gap_min",
            "split_gap_max", "ack_reply_pct", "loop_burst", "owner_defers", "cooldown_jitter", "catchup_min",
            "scan_interval")] + [
            Header(text=t("h_test")),
        ]
        if DialogPicker is not None:
            items.append(DialogPicker(key="test_pick", text=t("test_pick"), on_pick=self.on_test_style,
                                      subtext=t("test_pick_s")))
        last = str(self.get_setting("style_test_result", "") or "")
        if last:
            items.append(Header(text=t("h_test_result")))
            items.append(note(last))
        # 4. decisions log: always last
        items.append(Header(text=t("h_decisions")))
        rows = self.decision_rows()
        if rows:
            for title, sentence, _r in rows:
                items.append(Header(text=title))
                items.append(note(sentence))
            items.append(Text(text=t("log_copy"), key="log_copy", on_click=self.copy_log))
            items.append(Text(text=t("log_clear"), key="log_clear", on_click=self.clear_log))
        else:
            items.append(note(t("log_none")))
        items.append(note(t("decisions_note")))
        return items

    def on_chat_added(self, dialog_id, title):
        """DialogPicker / UsernameInput callback (UI thread, no blocking calls)."""
        try:
            did = int(dialog_id)
            if not did:
                return
            try:
                account = int(client.current_account())
            except Exception:
                account = 0
            key = self.chat_key(account, did)
            info = None
            try:
                info = client.get_dialog_info(did)       # cache only, cheap
            except Exception as e:
                self.log("info unavailable for %s: %s" % (key, e))
            if info is not None:
                reason = self.check_info(info)
                if reason:
                    client.bulletin(self.t("bl_na", self.rt(reason)))
                    return
                kind = info.get("type")
                name = str(info.get("title") or title or did)
            else:
                kind = "user" if did > 0 else "group"
                name = str(title or did)
            self.chat_on(account, did, name, kind)
            self._decide(key, "cmd", "menu_on")
            client.bulletin(self.t("bl_on", name))
        except Exception as e:
            self.error(e)

    def _remove_cb(self, key):
        def cb():
            title = self.chat_off(key, remove=True)
            if self._open_key == key:
                self._open_key = None
            if title is not None:
                client.bulletin(self.t("bl_removed", title))
        return cb

    def _test_cb(self, key):
        def cb():
            c = self._chats.get(key)
            if c:
                self.start_style_test(int(c.get("account", 0)), int(c["dialog_id"]), c.get("title", ""))
        return cb

    def _keep_cb(self, key):
        def cb(value):
            with self._lock:
                c = self._chats.get(key)
                if c:
                    upd = {"enabled": bool(value)}
                    if value:
                        upd["fails"] = 0
                    self._commit(key, set=upd)
        return cb

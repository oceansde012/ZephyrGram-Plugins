FEM_NAME_EXCEPTIONS = frozenset(u"""микита никита ілля илья лука кузьма данила сава фома гліб дима саша женя валя
слава юра ваня коля толя паша гоша міша миша вова вася петя льоша леша""".split())
GENDER_FEM_RE = re.compile(
    u"(?i)(?<!\\w)я\\s+(?:[^\\W\\d_]+\\s+){0,2}?(?:[^\\W\\d_]{2,}(?:ла|лась|лася)|рада|сама|готова|згодна|согласна|"
    u"впевнена|уверена|змучена|замучена|здивована|удивлена|зайнята|занята|одна|вдома одна|голодна|голодная)(?!\\w)")
GENDER_MASC_RE = re.compile(
    u"(?i)(?<!\\w)я\\s+(?:[^\\W\\d_]+\\s+){0,2}?(?:[^\\W\\d_]{2,}(?:вся|вшись|лся|лсь)|[^\\W\\d_]{2,}(?<!ол)(?<!ал)(?<!ил)(?<!ел)в|"
    u"[^\\W\\d_]{2,}л|рад|сам|готов|згоден|согласен|впевнений|уверен|змучений|замучен|здивований|удивлён|удивлен|"
    u"зайнятий|занят|один|голодний|голодный)(?!\\w)")


GENDER_FEM_ADDR_RE = re.compile(
    u"(?i)(?<!\\w)(?:ти|ты)\\s+(?:[^\\W\\d_]+\\s+){0,2}?[^\\W\\d_]{2,}(?:ла|лась|лася)(?!\\w)|"
    u"(?<!\\w)(?:красуня|красотка|дівчинко|девочка|дівчино|девушка|кохана|любимая|мила|милая)(?!\\w)")
GENDER_MASC_ADDR_RE = re.compile(
    u"(?i)(?<!\\w)(?:ти|ты)\\s+(?:[^\\W\\d_]+\\s+){0,2}?[^\\W\\d_]{2,}(?:вся|лся|л|в)(?!\\w)|"
    u"(?<!\\w)(?:братан|бро|брат|друже|чувак|пацан|хлопче|дядя)(?!\\w)")


def gender_scores(other_texts, owner_texts=()):
    """(feminine, masculine) hit counts."""
    fem = masc = 0
    for t in other_texts:
        t = str(t or "")
        fem += len(GENDER_FEM_RE.findall(t))
        masc += len(GENDER_MASC_RE.findall(t))
    for t in owner_texts:
        t = str(t or "")
        fem += len(GENDER_FEM_ADDR_RE.findall(t))
        masc += len(GENDER_MASC_ADDR_RE.findall(t))
    return fem, masc


def gender_level(other_texts, owner_texts=()):
    """('f' | 'm', firm: bool) or (None, False)."""
    fem, masc = gender_scores(other_texts, owner_texts)
    if fem >= GENDER_MIN_EVIDENCE and fem - masc >= 2:
        return "f", True
    if masc >= GENDER_MIN_EVIDENCE and masc - fem >= 2:
        return "m", True
    if fem >= 1 and masc == 0:
        return "f", False
    if masc >= 1 and fem == 0:
        return "m", False
    return None, False


def detect_gender(texts):
    """'f' / 'm' / None from how the OTHER person talks about..."""
    fem = masc = 0
    for t in texts:
        t = str(t or "")
        fem += len(GENDER_FEM_RE.findall(t))
        masc += len(GENDER_MASC_RE.findall(t))
    if fem >= GENDER_MIN_EVIDENCE and fem - masc >= 2:
        return "f"
    if masc >= GENDER_MIN_EVIDENCE and masc - fem >= 2:
        return "m"
    return None


def name_gender_hint(title):
    """Weak hint from a first name written in Cyrillic."""
    m = re.match(u"^\\W*([А-Яа-яІіЇїЄєҐґЁё]{3,})", str(title or ""))
    if not m:
        return None
    name = m.group(1).lower()
    if name in FEM_NAME_EXCEPTIONS or name in (u"ілля", u"илья"):
        return None
    return "f" if name[-1] in u"ая" else None



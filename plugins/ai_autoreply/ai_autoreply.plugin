    "h_general": ("General settings", "Загальні", "Общие"),
    "h_prompts": ("Prompts and model", "Промпти та модель", "Промпты и модель"),
    "h_test": ("Style test", "Тест стилю", "Тест стиля"),
    "ms_0": ("Auto", "Авто", "Авто"),
    "ms_1": ("Draft", "Чернетка", "Черновик"),
    "ms_2": ("Friend", "Друг", "Друг"),
    "st_on": ("on", "увімк.", "вкл."),
    "st_off": ("off", "вимк.", "выкл."),
    "last_pref": ("last: %s", "останнє: %s", "последнее: %s"),
    "reply_lang": ("Reply language", "Мова відповідей", "Язык ответов"),
    "reply_lang_s": ("The other person's language (default) = the language of the message being answered (then their "

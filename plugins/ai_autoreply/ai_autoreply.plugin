SENSITIVE_RE = re.compile(
    u"(?i)(?:парол|password|passcode|\\bpin\\b|\\bcvv|\\biban\\b|карт[аиоуы]?\\b|\\bcard\\b|\\bкод\\b|"
    u"паспорт|\\bпин\\b|\\d{6,}|https?://|@\\w{4,})")

CLOUD_HIDDEN = u"(hidden)"
_NUM_WORD = (u"(?:ноль|нуль|один|одна|два|две|дві|три|четыре|чотири|пять|п['’]?ять|шесть|шість|семь|сім|восемь|"
             u"вісім|девять|дев['’]?ять|zero|one|two|three|four|five|six|seven|eight|nine)(?!\\w)")
_NUM_WORDS = u"(?<!\\w)%s(?:[\\s,.-]+%s){%%d,}" % (_NUM_WORD, _NUM_WORD)
_PASS_KW = u"(?<!\\w)(?:парол\\w*|password\\w*|passwd|passphrase|passcode|pwd|пасс)(?!\\w)"
_CODE_KW = (u"(?<!\\w)(?:код|коды|кода|коду|коде|кодом|коди|кодів|codes?|otp|2fa|пин(?:-?код\\w*)?|пін(?:-?код\\w*)?|"
            u"pin(?:[- ]?code)?|cv[vc]2?)(?!\\w)")
CLOUD_SECRET_RES = (
    re.compile(u"(?i)" + _PASS_KW + u"[^\\n:=]{0,30}?(?:[:=]|\\s(?:is|это|це|будет|буде)(?!\\w)|\\s[—–-](?=\\s))"
               u"\\s*([^\\n]*\\S)"),
    re.compile(u"(?i)" + _PASS_KW + u"(?:\\s+[^\\s\\d:=]+){0,3}?\\s+((?=\\S*[\\d!@#$%^&*_])\\S{4,})"),
    re.compile(u"(?i)" + _CODE_KW + u"[^\\d\\n]{0,30}?(\\d(?:[ -]?\\d){2,9}(?!\\d)|" + _NUM_WORDS % 2 + u")"),
    re.compile(u"(?i)(?<!\\w)(?:iban|ібан)(?!\\w)\\W{0,5}([a-z]{2}\\d{2}(?: ?[a-z0-9]){8,30})"),
    re.compile(u"(?<![\\w/.=?&-])((?=[A-Za-z0-9_-]*\\d)(?=[A-Za-z0-9_-]*[A-Za-z])[A-Za-z0-9_-]{24,})(?![\\w/-])"),
)
_CARD_RE = re.compile(u"(?<![\\d+])\\d(?:[ -]?\\d){12,18}(?!\\d)")
_CARD_GROUPS_RE = re.compile(u"(?<![\\d+])\\d{4}([ -])\\d{4}\\1\\d{4}\\1\\d{4}(?:\\1\\d{1,3})?(?!\\d)")
_IBAN_RE = re.compile(u"(?i)(?<![a-z0-9])[a-z]{2}\\d{2}(?: ?[a-z0-9]){11,30}")
_CLOUD_WHOLE_RE = re.compile(
    u"(?i)\\s*(?:(?!(?:19|20)\\d\\d\\s*$)(?:\\d ?){3,7}\\d|" + _NUM_WORDS % 3 +
    u"|(?![@#/]|\\S*://|www\\.)(?=\\S*\\d)(?=\\S*[^\\W\\d_])\\S{8,64})\\s*")


def _luhn_ok(digits):
    total = 0
    for i, ch in enumerate(reversed(digits)):
        n = int(ch) * (2 if i % 2 else 1)
        total += n - 9 if n > 9 else n
    return total % 10 == 0


def _iban_end(match):
    """End offset of the longest valid IBAN (ISO 13616 mod 97) at the..."""
    chars = [(i, ch) for i, ch in enumerate(match.group(0)) if ch != " "]
    for n in range(min(len(chars), 34), 14, -1):
        value = "".join(ch for _i, ch in chars[:n]).upper()
        try:
            if int("".join(str(int(ch, 36)) for ch in value[4:] + value[:4])) % 97 == 1:
                return match.start() + chars[n - 1][0] + 1
        except ValueError:
            return None
    return None


def cloud_redact(text):
    """Text for the cloud memory with passwords, codes, card numbers..."""
    text = str(text or "")
    if _CLOUD_WHOLE_RE.fullmatch(text):
        return CLOUD_HIDDEN
    spans = []
    for rx in CLOUD_SECRET_RES:
        spans += [m.span(1) for m in rx.finditer(text)]
    spans += [m.span() for m in _CARD_GROUPS_RE.finditer(text)]
    spans += [m.span() for m in _CARD_RE.finditer(text) if _luhn_ok(re.sub(u"\\D", "", m.group(0)))]
    for m in _IBAN_RE.finditer(text):
        end = _iban_end(m)
        if end:
            spans.append((m.start(), end))
    merged = []
    for start, end in sorted(spans):
        if merged and start <= merged[-1][1]:
            merged[-1][1] = max(merged[-1][1], end)
        else:
            merged.append([start, end])
    out, pos = [], 0
    for start, end in merged:
        out += [text[pos:start], CLOUD_HIDDEN]
        pos = end
    return "".join(out) + text[pos:]


_PLUGIN_MARKER_RE = re.compile(u"\\[incoming (?:attachment|sticker \\d+)\\]")
_BRACKETS = {ord(u"["): u"(", ord(u"]"): u")", ord(u"［"): u"(", ord(u"］"): u")"}


def contact_text(text):
    """Contact-written text for a prompt."""
    text = str(text or "")
    if _PLUGIN_MARKER_RE.fullmatch(text.strip()):
        return text                      # the plugin's own placeholder of a media-only message
    return text.translate(_BRACKETS)


MIN_STATS = 8                # fewer own messages than this: no style rules, no post-style
MIN_OWN = 12                 # cross-chat style borrowing only with explicit style_share consent
MAX_EXAMPLE_CHARS = 200
MAX_TYPING_TOTAL = 2.5       # default cap (s) for all parts of one reply; setting 'typing_cap' overrides
MIN_TYPING_TOTAL = 0.4
SPLIT_MIN_CHARS = 120        # replies up to this length are never split
MAX_OWNER_DEFERS = 2         # a batch held back by the owner-active rule is retried this many times
OWNER_PARTIAL_RULE = ("I (the owner) already answered their earlier messages myself: my messages are in the "
                      "conversation above. Take them into account, do not repeat or contradict them, and answer "
                      "only the newest message(s) that are still open.")
MAX_DEBOUNCE_TOTAL = 20.0    # a batch is answered at the latest this long after its first message
AUTH_RESUME_SEC = 1800       # a chat auto-disabled by errors is re-enabled after this long
POLITE_STOP_TEXT = u"ок, я трохи зайнятий, напишу пізніше"
DEFAULT_MAX_PARTS = 2        # default maximum; explicit settings keep their selected value
NEWLINE_PCT = 10             # chance (%) that a line break between two finished thoughts stays in one message
SHORT_SPLIT_CHARS = 45       # in that mode even a one-line answer longer than this is split at sentence ends
SHORT_MAX_WORDS = 20         # in that mode a sentence with more words than this counts as too complex
REVIVE_AFTER_MIN = 20        # silence of the other person (minutes) before the bot may restart the conversation
REVIVE_WINDOW_H = 3          # ... but only within this many hours after the last message (older chats are finished)
REVIVE_DAILY = 3             # at most this many revivals per chat and day
REVIVE_CHECK_SEC = 300       # one chat's history is looked at for a revival at most this often
REVIVE_PER_PASS = 3          # at most this many chats are examined per scan pass
DECISIONS_MAX = 400          # decision log depth (the settings screen shows 10, "Copy log" the last 40)
DECISIONS_FLUSH_SEC = 5.0    # the log is written to the settings store at most this often (+ on unload / copy / clear)
REPORT_WINDOW_SEC = 3600     # the diagnostic report covers this many seconds
REPORT_MAX_CHARS = 15000     # ... and is at most this long (the oldest timeline lines are dropped first)
REPORT_MAX_CHATS = 12        # chats with a state snapshot and a timeline in the report
REPORT_HIST_MSGS = 15        # history rows per chat in the report (time, direction, length, type; never the text)
REPORT_STUCK_SEC = 300       # a busy flag with no decision / incoming / send for this long is reported as stuck
REPORT_PAUSE_SEC = 600       # an incoming message with no reply and no decision for this long is a suspicious pause

# ---- cost control (0.5.2): one request never balloons, background helpers use a cheap model
PROMPT_MAX_DEFAULT = 24000   # one reply request (system prompt + messages), characters; setting 'prompt_max'
PROMPT_MAX_MIN = 8000
PROMPT_MAX_HARD = 60000      # no setting can make one request bigger than this (~15-20k tokens)
RETRY_RESERVE = 800          # room kept for the note the second attempt adds to the system prompt
SYSTEM_SHARE = 0.55          # rules + style examples + lore + your prompt take at most this share of a request
STYLE_MIN_EXAMPLES = 12
STYLE_MAX_SHARE = 0.4        # ... unless the style section alone would take more than this share of the system part
CUSTOM_PROMPT_MAX = 4000     # your own prompt (default or per chat) inside one request
CHARS_PER_TOKEN = 3.0        # rough estimate for Cyrillic chat text (English is ~4); only used for the log
HELPER_KINDS = ("memory", "learn", "sticker")   # background helpers: 'model_cheap' (empty = 'model')
AI_KINDS = ("reply", "command", "revive", "test") + HELPER_KINDS
HELPER_DAILY = 200           # helper AI calls per day in all chats; setting 'helper_daily' (0 = none)
HELPER_MAX_CHARS = 30000     # one helper request is refused above this
CHEAP_FAIL_PAUSE = 1800      # after a failure of the cheap model the helpers use the main model this long
AI_RING_MAX = 300            # recent AI requests (time, chat, kind, size) kept in memory for the report
MEM_SUMMARY_MAX = 8000       # stored chat summary, characters (the summarizer is asked for MEM_ASK_CHARS)
MEM_ASK_CHARS = 6000
MEM_INJECT_MAX = 3000        # the part of the summary sent with one reply (the most important facts come first)
MEM_INPUT_MSGS = 16000       # new messages per summarizer call (JSON); the previous summary comes on top
MEM_KEEP_NEWEST = 12         # the newest messages are never summarized: they are in the reply context anyway
MEM_FIRST_MIN = 10           # eligible messages needed for a first summary
MEM_NEW_MIN = 20             # new messages needed for an update ...
MEM_IDLE_MIN = 4             # ... or this many when the summary is older than MEM_IDLE_SEC
MEM_IDLE_SEC = 6 * 3600
MEM_URGENT_NEW = 56          # this many new messages: the 100-row history window is close to losing some
MEM_GAP_SEC = 120            # min time between two updates of one chat (30 s when urgent)
MEM_FAIL_SEC = 600           # after a failed update
MEM_CHECK_SEC = 90           # a reply looks (in the background) whether an update is due at most this often
MEM_CHAIN = 3                # calls one update may chain when the new messages do not fit into one call
MEM_DAILY = 6                # summarizer calls per chat and day; setting 'memory_daily'
MEM_RAW_KEEP = 16            # with a summary, history it covers is sent raw only for the newest this many rows
MEM_SEEN_KICK = 40           # messages seen in an enabled chat (also without replies) that start an update check

PRESET_NAMES = ["Balanced", "Chatty", "Quiet", "Live (human-like, default)"]
LIVE_PRESET = 3              # used when no preset is stored (new installs and settings without an explicit choice)

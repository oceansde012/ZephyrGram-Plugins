    "preset_0": ("Balanced", "Збалансований", "Сбалансированный"),
    "preset_1": ("Chatty", "Балакучий", "Разговорчивый"),
    "preset_2": ("Quiet", "Тихий", "Тихий"),
    "tone_0": ("Neutral", "Нейтральний", "Нейтральный"),
    "tone_1": ("Friendly", "Дружній", "Дружелюбный"),
    "tone_2": ("Toxic (sarcastic banter)", "Токсичний (саркастичні підколки)", "Токсичный (саркастичные подколки)"),
    # owner command
    "h_cmd": ("Command .ai (bot writes first)",
             "Команда .ai (бот пише першим)",
             "Команда .ai (бот пишет первым)"),
    "cmd_note": ("Type it in a chat; the command itself is not sent.\n.ai - continues the conversation (or opens it) in your style.\n.ai <topic> - first message about it, no invented facts.\n.ai ? - puts the result into the input field.\nIgnores cooldown and limits; every use goes to the log.",
                "Напишіть її в чаті; сама команда не надсилається.\n.ai — продовжує розмову (або починає її) у вашому стилі.\n.ai <тема> — перше повідомлення на тему, без вигаданих фактів.\n.ai ? — кладе результат у поле вводу.\nІгнорує паузи й ліміти; кожне використання пишеться в журнал.",
                "Напишите её в чате; сама команда не отправляется.\n.ai — продолжает разговор (или начинает его) в вашем стиле.\n.ai <тема> — первое сообщение на тему, без выдуманных фактов.\n.ai ? — кладёт результат в поле ввода.\nИгнорирует паузы и лимиты; каждое использование пишется в журнал."),
    "cmd_on": ("Enable the command", "Увімкнути команду", "Включить команду"),
    "cmd_on_s": ("Off = the text is sent as a normal message.", "Вимк. = текст надсилається як звичайне повідомлення.",
                 "Выкл. = текст отправляется как обычное сообщение."),
    "cmd_triggers": ("Command words (comma separated)", "Слова команди (через кому)",
                     "Слова команды (через запятую)"),
    "cmd_triggers_s": ("Default: .ai, .аі",
                      "Типово: .ai, .аі",
                      "По умолчанию: .ai, .аі"),
    "cmd_mode": ("The command", "Команда", "Команда"),
    "cmd_mode_0": ("Sends the message", "Надсилає повідомлення", "Отправляет сообщение"),
    "cmd_mode_1": ("Puts it into the draft", "Кладе в чернетку", "Кладёт в черновик"),
    "cmd_any": ("Allow the command in any private chat", "Дозволити команду в будь-якому приватному чаті",
                "Разрешить команду в любом личном чате"),
    "cmd_any_s": ("Off = only chats in the list. Never secret chats or bots.",
                 "Вимк. = лише чати зі списку. Ніколи секретні чати й боти.",
                 "Выкл. = только чаты из списка. Никогда секретные чаты и боты."),
    "cmd_openers": ("Opening phrases (one per line)", "Фрази-відкривачки (по одній у рядку)",
                    "Фразы-открывашки (по одной в строке)"),
    "cmd_openers_s": ("Used when there is no fresh context. Empty = built-in list.",
                     "Коли свіжого контексту нема. Порожньо = вбудований список.",
                     "Когда свежего контекста нет. Пусто = встроенный список."),
    # humanize block
    "h_humanize": ("Style and humanity",
                  "Стиль і людяність",
                  "Стиль и человечность"),
    "humanize": ("Humanize replies", "Людяні відповіді", "Человечные ответы"),
    "humanize_s": ("Casual and short like you, no assistant phrases. Off = plain assistant.",
                  "Невимушено й коротко, як ви, без фраз асистента. Вимк. = звичайний асистент.",
                  "Непринуждённо и коротко, как вы, без фраз ассистента. Выкл. = обычный ассистент."),
    "learn": ("Learn my style", "Вчити мій стиль", "Учить мой стиль"),
    "learn_s": ("Your recent sent messages go as examples to your own AI server only.",
               "Ваші недавні надіслані повідомлення йдуть як приклади лише на ваш власний ШІ-сервер.",
               "Ваши недавние отправленные сообщения идут как примеры только на ваш собственный ИИ-сервер."),
    "learn_n": ("Style examples (5-100)", "Прикладів стилю (5-100)", "Примеров стиля (5-100)"),
    "relearn": ("Re-learn style every (minutes)", "Оновлювати стиль кожні (хв)", "Обновлять стиль каждые (мин)"),
    "tone": ("Tone", "Тон", "Тон"),
    "split": ("Split long replies", "Ділити довгі відповіді", "Делить длинные ответы"),
    "split_s": ("Replies over ~120 characters, into 2 messages at most.",
               "Відповіді довші за ~120 символів, максимум на 2 повідомлення.",
               "Ответы длиннее ~120 символов, максимум на 2 сообщения."),
    "typing": ("Typing delay", "Затримка набору", "Задержка набора"),
    "typing_s": ("0.4-2.5 s pause before sending.",
                "Пауза 0,4-2,5 с перед надсиланням.",
                "Пауза 0,4-2,5 с перед отправкой."),
    "typing_cap": ("Typing delay cap (s)",
                  "Ліміт затримки набору (с)",
                  "Предел задержки набора (с)"),
    "banned": ("Extra banned words (comma separated)", "Додаткові заборонені слова (через кому)",

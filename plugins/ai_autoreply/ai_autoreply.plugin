    "o_test": ("test", "тест", "тест"),
    # settings
    "h_title": ("AI auto-reply", "ШІ-автовідповідач", "ИИ-автоответчик"),
    "master": ("Master switch", "Головний перемикач", "Главный переключатель"),
    "master_s": ("Off = never answers anywhere", "Вимк. = ніде не відповідає", "Выкл. = нигде не отвечает"),
    "lang": ("Interface language", "Мова інтерфейсу", "Язык интерфейса"),
    "lang_s": ("Auto = the phone language (Ukrainian or Russian), else Ukrainian.",
              "Авто = мова телефона (українська чи російська), інакше українська.",
              "Авто = язык телефона (украинский или русский), иначе украинский."),
    "preset": ("Preset", "Пресет", "Пресет"),
    "preset_s": ("Live: answers like a person (2-9 s, typing), almost no limits. Balanced: ~5 s, up to 20 replies/h per chat. Chatty: more often. Quiet: rarely. Empty fields under “More settings” follow the preset.",
                "Жива людина: відповідає як людина (2-9 с, набір тексту), майже без лімітів. Збалансований: ~5 с, до 20 відповідей/год у чаті. Балакучий: частіше. Тихий: рідко. Порожні поля в «Більше налаштувань» беруть значення пресету.",
                "Живой человек: отвечает как человек (2-9 с, набор текста), почти без лимитов. Сбалансированный: ~5 с, до 20 ответов/ч в чате. Разговорчивый: чаще. Тихий: редко. Пустые поля в «Больше настроек» берут значение пресета."),
    "h_decisions": ("Recent decisions", "Останні рішення", "Последние решения"),
    "decisions_note": ("Newest first. No message text is stored.",
                      "Спочатку нові. Текст повідомлень не зберігається.",
                      "Сначала новые. Текст сообщений не хранится."),
    "h_add": ("Add chat", "Додати чат", "Добавить чат"),
    "add_pick": ("Choose from my chats", "Вибрати з моїх чатів", "Выбрать из моих чатов"),
    "add_user": ("Add by @username or t.me link", "Додати за @username або посиланням t.me",

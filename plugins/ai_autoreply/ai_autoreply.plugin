    "voice_unavailable": ("voice audio could not be downloaded or exceeds limits", "голосове не завантажене або перевищує ліміт", "голосовое не загрузилось или превышает лимит"),
    "voice_transcribed": ("voice message transcribed", "голосове розпізнано", "голосовое распознано"),
    "voice_transcription_unavailable": ("voice recognition unavailable on the AI server (including 403); no transcript was used", "розпізнавання голосу недоступне на ШІ-сервері (зокрема 403); текст не використано", "распознавание голоса недоступно на ИИ-сервере (включая 403); текст не использован"),
    "ok": ("reply sent", "відповідь надіслано", "ответ отправлен"),
    "ok_fallback": ("sent the best variant (the model kept using banned words or AI-like phrases)",
                    "надіслано найкращий варіант (модель кілька разів використала заборонені слова чи ШІ-фрази)",
                    "отправлен лучший вариант (модель несколько раз использовала запрещённые слова или ИИ-фразы)"),
    "polite_stop": ("hourly limit reached: sent one polite stop line",
                    "ліміт на годину вичерпано: надіслано один ввічливий рядок-зупинку",
                    "лимит в час исчерпан: отправлена одна вежливая строка-остановка"),
    "scan_found": ("found by the safety-net scan: the message was not delivered by an event",

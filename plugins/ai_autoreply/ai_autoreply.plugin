def note(text):
    """Non-interactive multi-line explanation row."""
    d = Divider()
    d.text = str(text)
    return d


def tr(lang, key):
    row = S.get(key) or R.get(key)
    if row is None:
        return key
    i = LANGS.index(lang) if lang in LANGS else 0
    return row[i] or row[0]


AI_CODE_NAMES = {            # ZephyrGram AiError.code -> (en, uk, ru)
    1: ("AI server not configured", "ШІ-сервер не налаштований", "ИИ-сервер не настроен"),
    2: ("AI server refused the token", "ШІ-сервер відхилив токен", "ИИ-сервер отклонил токен"),
    3: ("limit or quota reached", "ліміт або квота вичерпані", "лимит или квота исчерпаны"),
    4: ("AI server is starting", "ШІ-сервер запускається", "ИИ-сервер запускается"),
    5: ("no answer in time (network or timeout)", "немає відповіді вчасно (мережа або таймаут)",
        "нет ответа вовремя (сеть или таймаут)"),
    6: ("AI server error", "помилка ШІ-сервера", "ошибка ИИ-сервера"),
    0: ("other error", "інша помилка", "другая ошибка"),
}
TRANSIENT_AI_CODES = (3, 4, 5, 6)   # passing reasons: they never switch a chat off


def reason_text(lang, code):
    """Plain-language explanation of a stored reason code (unknown..."""
    code = str(code or "")
    row = R.get(code)
    ms = re.match(r"^sticker_skipped_(\w+)$", code)
    if row is None and ms:
        base = R["sticker_skipped"]
        why = reason_text(lang, "sticker_why_" + ms.group(1))
        return (base[LANGS.index(lang) if lang in LANGS else 0] or base[0]) % why
    ma = re.match(r"^ai_slow_(\d+)$", code)
    if row is None and ma:
        base = R["ai_slow"]
        return (base[LANGS.index(lang) if lang in LANGS else 0] or base[0]) % ma.group(1)
    me = re.match(r"^ai_err_(\d+)_(\d+)$", code)
    if row is None and me:
        base = R["ai_err"]
        names = AI_CODE_NAMES.get(int(me.group(1)), AI_CODE_NAMES[0])
        return (base[LANGS.index(lang) if lang in LANGS else 0] or base[0]) % (
            me.group(2), names[LANGS.index(lang) if lang in LANGS else 0] or names[0])
    mw = re.match(r"^latency_wait_(\d+)$", code)
    if row is None and mw:
        base = R["latency_wait"]
        return (base[LANGS.index(lang) if lang in LANGS else 0] or base[0]) % mw.group(1)
    if row is None:
        for prefix in ("ok_fallback", "process_exception"):
            if code.startswith(prefix):
                row = R[prefix]
                break
    if row is None:
        return code.replace("_", " ")
    return row[LANGS.index(lang) if lang in LANGS else 0] or row[0]


# --- "bot writes first" command
FOLD_MAP = {ord(a): b for a, b in zip(u"аіїоеср", u"aiioecp")}


def fold_cmd(text):
    """Lower case + Cyrillic look-alikes folded to Latin, so '.аі' ==..."""
    return str(text or "").lower().translate(FOLD_MAP)



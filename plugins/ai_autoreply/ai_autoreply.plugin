    "o_draft": ("draft written", "чернетку записано", "черновик записан"),
    "o_skip": ("skipped", "пропущено", "пропущено"),
    "o_error": ("error", "помилка", "ошибка"),
    "o_disabled": ("chat switched off", "чат вимкнено", "чат отключён"),

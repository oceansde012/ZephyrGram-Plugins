     "skip_ack": False, "group_need_question": False, "typing_cap": 2.5},
    {"debounce": 6, "debounce_jitter": 3, "cooldown": 60, "chat_hourly": 6, "owner_active": 300,
     "skip_ack": True, "group_need_question": True, "typing_cap": 2.0},
    {"debounce": 2, "debounce_jitter": 3, "cooldown": 0, "cooldown_jitter": 3, "chat_hourly": 60,
     "owner_active": 15, "skip_ack": True, "group_need_question": True, "typing_cap": 2.5,

    "add_user_s": ("Public usernames only.",
                  "Лише публічні імена.",
                  "Только публичные имена."),
    "add_old": ("Add a chat with the 'AI auto-reply' item in the chat header menu.",
                "Додайте чат пунктом «ШІ-автовідповідач» у меню заголовка чату.",
                "Добавьте чат пунктом «ИИ-автоответчик» в меню заголовка чата."),
    "mode_auto": ("Auto (answer right away)", "Авто (відповідати одразу)", "Авто (отвечать сразу)"),
    "mode_draft": ("Draft (put reply into the input field)", "Чернетка (відповідь у поле вводу)",

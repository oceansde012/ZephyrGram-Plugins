    "skip_emoji": ("Skip emoji-only messages", "Пропускати повідомлення лише з емодзі", "Пропускать сообщения только из эмодзи"),
    "max_reply": ("Max reply length (characters)", "Макс. довжина відповіді (символів)", "Макс. длина ответа (символов)"),
    "temperature": ("Temperature (0-2)", "Температура (0-2)", "Температура (0-2)"),
    "test_pick": ("Test style: choose a chat", "Тест стилю: вибрати чат", "Тест стиля: выбрать чат"),
    "test_pick_s": ("5 sample replies to the last incoming messages. Nothing is sent.",
                   "5 пробних відповідей на останні вхідні. Нічого не надсилається.",
                   "5 пробных ответов на последние входящие. Ничего не отправляется."),
    "h_test_result": ("Last style test", "Останній тест стилю", "Последний тест стиля"),
    "default_prompt": ("Default system prompt", "Системний промпт за замовчуванням", "Системный промпт по умолчанию"),
    "default_prompt_s": ("Extra instructions for every chat. Empty = none.",
                        "Додаткові інструкції для всіх чатів. Порожньо = без них.",
                        "Дополнительные инструкции для всех чатов. Пусто = без них."),
    "answer_detail": ("Answer detail", "Докладність відповіді", "Подробность ответа"),
    "detail_0": ("Short", "Коротко", "Кратко"),
    "detail_1": ("Balanced (default)", "Збалансовано (типово)", "Сбалансированно (по умолчанию)"),

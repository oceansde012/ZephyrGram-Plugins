# reason code (as stored in the decision log) -> (English, Ukrainian, Russian) plain-language explanation
R = {
    "ok": ("reply sent", "відповідь надіслано", "ответ отправлен"),
    "ok_fallback": ("sent the best variant (the model kept using banned words or AI-like phrases)",
                    "надіслано найкращий варіант (модель кілька разів використала заборонені слова чи ШІ-фрази)",
                    "отправлен лучший вариант (модель несколько раз использовала запрещённые слова или ИИ-фразы)"),
    "polite_stop": ("hourly limit reached: sent one polite stop line",
                    "ліміт на годину вичерпано: надіслано один ввічливий рядок-зупинку",
                    "лимит в час исчерпан: отправлена одна вежливая строка-остановка"),
    "outgoing": ("it is your own message", "це ваше власне повідомлення", "это ваше собственное сообщение"),
    "master_off": ("the master switch is off", "головний перемикач вимкнено", "главный переключатель выключен"),
    "sender_is_bot": ("the sender is a bot", "відправник — бот", "отправитель — бот"),
    "no_text_service_message": ("no text (service message, sticker or media without caption)",
